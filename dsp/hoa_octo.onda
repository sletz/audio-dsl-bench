# examples/ambisonics/fourSourcesToOcto.dsp ported to Onda, like hoa_octo.dsp: four mono sources
# encoded at order 3 by ho.map (distance gain 1/max(r^2, 1), circular harmonics W, S1, C1, S2, C2,
# S3, C3, ho.wider with the opening min(r, 1)), radius and angle smoothed by si.smooth(tau2pole(0.02)),
# summed, then ho.optimInPhase(3) and ho.decoder(3, 8) folded in one 8 x 7 matrix of constants.
# Named ports gathered in a local array (not the ins/outs views).

include "common/float_limits.onda"

params:
  Radius1 = 1.0 {0.0, 5.0}
  Angle1 = 0.0 {-6.2831855, 6.2831855}
  Radius2 = 1.0 {0.0, 5.0}
  Angle2 = 0.0 {-6.2831855, 6.2831855}
  Radius3 = 1.0 {0.0, 5.0}
  Angle3 = 0.0 {-6.2831855, 6.2831855}
  Radius4 = 1.0 {0.0, 5.0}
  Angle4 = 0.0 {-6.2831855, 6.2831855}

# Speaker k at 2 pi k / 8: 0.5 * 2/8 for W, then 2/8 * inPhase weight (0.75, 0.3, 0.05) * sin/cos(n a_k)
const M: f32[56] = [
  0.125,
  0.0,
  0.1875,
  0.0,
  0.075,
  0.0,
  0.0125,
  0.125,
  0.13258252,
  0.13258252,
  0.075,
  0.0,
  0.008838835,
  -0.008838835,
  0.125,
  0.1875,
  0.0,
  0.0,
  -0.075,
  -0.0125,
  0.0,
  0.125,
  0.13258252,
  -0.13258252,
  -0.075,
  0.0,
  0.008838835,
  0.008838835,
  0.125,
  0.0,
  -0.1875,
  0.0,
  0.075,
  0.0,
  -0.0125,
  0.125,
  -0.13258252,
  -0.13258252,
  0.075,
  0.0,
  -0.008838835,
  0.008838835,
  0.125,
  -0.1875,
  0.0,
  0.0,
  -0.075,
  0.0125,
  0.0,
  0.125,
  -0.13258252,
  0.13258252,
  -0.075,
  0.0,
  -0.008838835,
  -0.008838835
]

init:
  rE: f32[4]  # si.smooth (error form) of the radii: y = x + e ...
  rXp: f32[4]  # ... e = pole * (e + x[n-1] - x)
  aE: f32[4]  # same for the angles
  aXp: f32[4]
  pole = exp(-(50.0 / SR))  # ba.tau2pole(0.02)

block:
  rT: f32[4] = [Radius1, Radius2, Radius3, Radius4]
  aT: f32[4] = [Angle1, Angle2, Angle3, Angle4]
  angle_sin: f32[4]
  angle_cos: f32[4]
  angle_settled = true
  for i in 0..4:
    angle_settled = angle_settled && aXp[i] == aT[i] && aT[i] + aE[i] == aT[i]
    angle_sin[i] = sin(aT[i])
    angle_cos[i] = cos(aT[i])
  sample:
    x = [in1, in2, in3, in4]
    ch: f32[7]
    for i in 0..4:
      rE[i] = pole * (min(float_limits::MaxFinite, rXp[i] - rT[i]) + rE[i])
      rXp[i] = rT[i]
      r = rT[i] + rE[i]
      aE[i] = pole * (min(float_limits::MaxFinite, aXp[i] - aT[i]) + aE[i])
      aXp[i] = aT[i]
      a = aT[i] + aE[i]
      # ho.map: distance gain and opening of ho.wider
      op = min(r, 1.0)
      g = x[i] * (1.0 + 1.3862944 * (1.0 - op)) / max(r * r, 1.0)
      # ho.wider weights of orders 1, 2, 3: ((op * log 4) - log n) / (log(n + 1) - log n), clipped to [0, 1]
      w1 = clamp(2.0 * op, 0.0, 1.0)
      w2 = clamp(2.4663033 * (-0.6931472 + 1.3862944 * op), 0.0, 1.0)
      w3 = clamp(3.4760594 * (-1.0986123 + 1.3862944 * op), 0.0, 1.0)
      # ho.encoder(3): W, S1, C1, S2, C2, S3, C3
      g1 = g * w1
      g2 = g * w2
      g3 = g * w3
      # Derive the second and third harmonics from the fundamental pair.
      sa = angle_sin[i]
      ca = angle_cos[i]
      if !angle_settled:
        sa = sin(a)
        ca = cos(a)
      s2 = 2.0 * sa * ca
      c2 = (ca + sa) * (ca - sa)
      s3 = sa * c2 + ca * s2
      c3 = ca * c2 - sa * s2
      ch[0] += g
      ch[1] += g1 * sa
      ch[2] += g1 * ca
      ch[3] += g2 * s2
      ch[4] += g2 * c2
      ch[5] += g3 * s3
      ch[6] += g3 * c3
    y: f32[8]
    for k in 0..8:
      acc = M[k * 7] * ch[0]
      for j in 1..7:
        acc += M[k * 7 + j] * ch[j]
      y[k] = acc
    out1 = y[0]
    out2 = y[1]
    out3 = y[2]
    out4 = y[3]
    out5 = y[4]
    out6 = y[5]
    out7 = y[6]
    out8 = y[7]
