// dm.compressor_demo (co.compressor_stereo with makeup gain), after dsp/compressor.onda, without
// the bypass and the gain meter like compressor.dsp. Detector: |x| + |y| through an attack/release
// one-pole (an.amp_follower_ar = si.onePoleSwitching), in dB, gain computer, knee smoother
// (si.smooth, error form, pole tau2pole(att/2)), back to linear. The parameter-only values are
// hoisted out of the sample loop by the optimiser.
processor Compressor {
    input stream in1;
    input stream in2;
    output stream out1;
    output stream out2;
    input parameter float ratio = 5.0 [[ min: 1.0, max: 20.0 ]];
    input parameter float threshold = -30.0 [[ min: -100.0, max: 10.0 ]];
    input parameter float attack = 50.0 [[ min: 1.0, max: 1000.0 ]];
    input parameter float release = 500.0 [[ min: 1.0, max: 1000.0 ]];
    input parameter float makeupgain = 12.0 [[ min: -96.0, max: 96.0 ]];
    state float env, gdbPrev, err;

    process {
        let t = 1.0 / sampleRate;
        let mgain = pow (10.0, 0.05 * makeupgain);                // ba.db2linear
        let slope = 1.0 / max (0.0000001192092896, ratio) + -1.0;  // 1/max(ma.EPSILON, ratio) - 1
        let att = max (t, 0.001 * attack);                         // attack in s, at least one sample
        let rel = max (t, 0.001 * release);
        let poleAtt = exp (-(t / att));                            // ba.tau2pole(att)
        let poleRel = exp (-(t / rel));                            // ba.tau2pole(rel)
        let poleKnee = exp (-(t / (0.5 * att)));                   // ba.tau2pole(att/2)
        let x1 = in1;
        let x2 = in2;
        let x = abs (abs (x1) + abs (x2));
        let c = select (x > env, poleAtt, poleRel);              // branchless: 10.8 ns with a ternary
        env = x * (1.0 - c) + env * c;
        // ba.linear2db: 20*log10(max(ma.MIN, env)), log10 written log * 1/ln(10) like the Onda port
        let gdb = slope * max (20.0 * (log (max (1.175494351e-38, env)) * 0.4342944819) - threshold, 0.0);
        err = poleKnee * (err + min (3.4028235e38, gdbPrev - gdb));
        gdbPrev = gdb;
        let g = pow (10.0, 0.05 * (gdb + err));
        out1 = mgain * x1 * g;
        out2 = mgain * x2 * g;
    }
}

graph Main {
    input stream in1;
    input stream in2;
    output stream out1;
    output stream out2;
    node p = Compressor;
    connection { in1 -> p.in1; in2 -> p.in2; p.out1 -> out1; p.out2 -> out2; }
}
