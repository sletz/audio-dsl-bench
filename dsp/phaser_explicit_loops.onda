# dm.phaser2_demo of Faust's demos.lib (examples/phasing/phaser.dsp) ported to Onda, like
# phaser.dsp: pf.phaser2_stereo with 4 notches, invert and vibrato mode off, no bypass. Each
# channel: a feedback loop around 4 second-order allpass sections (TPT state-variable filter in
# allpass form, x - bp(2k*x)) whose pole angles follow an LFO (fixed-point phasor, os.lf_sawpos;
# sine on the left, cosine on the right), then the dry input mixed with the allpass chain.
# The equations are written as the Faust compiler simplifies them (om = 1 - R from ma.expm1).

params:
  speed = 0.5 {0.0, 10.0}
  depth = 1.0 {0.0, 1.0}
  fb = 0.0 {-0.999, 0.999}
  width = 1000.0 {10.0, 5000.0}
  frqmin = 100.0 {20.0, 5000.0}
  frqmax = 800.0 {20.0, 10000.0}
  fratio = 1.5 {1.1, 4.0}
  level = 0.0 {-60.0, 10.0}

include "common/phaser.onda"

init:
  phase = 0  # os.lf_sawpos phasor: 30-bit integer part ...
  phaseFrac = 0  # ... and 24-bit fraction
  apl0 = Ap2()
  apl1 = Ap2()
  apl2 = Ap2()
  apl3 = Ap2()
  apr0 = Ap2()
  apr1 = Ap2()
  apr2 = Ap2()
  apr3 = Ap2()
  yl = 0.0  # chain outputs, fed back through fb
  yr = 0.0

block:
  lvl = pow(10.0, 0.05 * level)  # ba.db2linear
  g2 = 0.5 * depth
  g1 = lvl * (1.0 - g2)
  hy = 0.5 * max(-(PI / SR * width), -80.0)
  ex = exp(hy)
  sh = sinh1(hy)  # om = -ma.expm1(-pi*width/SR) = -2*ex*sh
  om2q = (ex * ex) * (sh * sh)
  omc = 2.0 * ex * sh + 1.0
  fqq = sh * (ex * sh + 1.0)  # fq = -4*ex*fqq
  kq = 8.0 * ex * fqq
  uq = 16.0 * ex * fqq
  th0 = TWO_PI * frqmin  # SR * (pole angle of the first notch), from frqmin ...
  thr = PI * (frqmin - max(frqmin, frqmax))  # ... and frqmax
  r0 = 1.0 / SR  # notch i at fratio^i times the first one
  r1 = (1.0 / SR) * fratio
  r2 = (1.0 / SR) * (fratio * fratio)
  r3 = (1.0 / SR) * (fratio * fratio * fratio)
  inc = f32(1 << 30) * (1.0 / SR) * speed  # 2^30 * f / SR
  incInt = i32(floor(inc))
  incFrac = i32(16777216.0 * (inc - floor(inc)))
  # Combine the 30 integer and 24 fractional bits before stepping the phasor.
  start = (i64(phase) << 24) + i64(phaseFrac)
  step = (i64(incInt) << 24) + i64(incFrac)
  left: f32[BS]
  right: f32[BS]
  for i in 0..BS:
    position = start + i64(i) * step
    ph = PhaseToRadians * f32((position >> 30) & 16777215)
    left[i] = th0 - thr * (1.0 - sin(ph))
    right[i] = th0 - thr * (1.0 - cos(ph))
  finish = start + i64(BS) * step
  phase = i32((finish >> 24) & 1073741823)
  phaseFrac = i32(finish & 16777215)

  # Each pass prepares one stage across a block, ahead of the serial feedback.
  ratios: f32[4] = [r0, r1, r2, r3]
  p: f32[8 * BS]
  q: f32[8 * BS]
  g: f32[8 * BS]
  for i in 0..4:
    ratio = ratios[i]
    for j in 0..BS:
      h = 0.5 * min(2.984513, ratio * left[j])
      c = coefficients(h, om2q, omc, kq)
      p[i * BS + j] = c[0]
      q[i * BS + j] = c[1]
      g[i * BS + j] = c[2]
    for j in 0..BS:
      h = 0.5 * min(2.984513, ratio * right[j])
      c = coefficients(h, om2q, omc, kq)
      p[(i + 4) * BS + j] = c[0]
      q[(i + 4) * BS + j] = c[1]
      g[(i + 4) * BS + j] = c[2]

  frame = 0 {BS, wrap}
  sample:
    # left channel, LFO phase 0 (sine)
    xl = lvl * in1
    fl = fb * yl
    l0 = apl0.tick(xl + fl, [p[0 * BS + frame], q[0 * BS + frame], g[0 * BS + frame]], uq)
    l1 = apl1.tick(xl - l0 + fl, [p[1 * BS + frame], q[1 * BS + frame], g[1 * BS + frame]], uq)
    l01 = l0 + l1
    l2 = apl2.tick(xl - l01 + fl, [p[2 * BS + frame], q[2 * BS + frame], g[2 * BS + frame]], uq)
    l012 = l01 + l2
    l3 = apl3.tick(xl - l012 + fl, [p[3 * BS + frame], q[3 * BS + frame], g[3 * BS + frame]], uq)
    yl = xl - (l012 + l3) + fl
    out1 = g1 * in1 + g2 * yl
    # right channel, LFO phase 1 (cosine)
    xr = lvl * in2
    fr = fb * yr
    q0 = apr0.tick(xr + fr, [p[4 * BS + frame], q[4 * BS + frame], g[4 * BS + frame]], uq)
    q1 = apr1.tick(xr - q0 + fr, [p[5 * BS + frame], q[5 * BS + frame], g[5 * BS + frame]], uq)
    q01 = q0 + q1
    q2 = apr2.tick(xr - q01 + fr, [p[6 * BS + frame], q[6 * BS + frame], g[6 * BS + frame]], uq)
    q012 = q01 + q2
    q3 = apr3.tick(xr - q012 + fr, [p[7 * BS + frame], q[7 * BS + frame], g[7 * BS + frame]], uq)
    yr = xr - (q012 + q3) + fr
    out2 = g1 * in2 + g2 * yr
    frame += 1
