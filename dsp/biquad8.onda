ins 1
params:
  cutoff = 1000.0 {20.0, 20000.0}
  q = 0.707 {0.1, 10.0}

init:
  w1: f32[8]
  w2: f32[8]

block:
  w0 = TWO_PI * cutoff / SR
  alpha = sin(w0) / (2.0 * q)
  cw = cos(w0)
  a0 = 1.0 + alpha
  b0 = (1.0 - cw) * 0.5 / a0
  b1 = (1.0 - cw) / a0
  b2 = b0
  a1 = -2.0 * cw / a0
  a2 = (1.0 - alpha) / a0
  sample:
    x = in1
    for i in 0..8:
      w = x + (-a1 * w1[i] - a2 * w2[i])
      x = b0 * w + b1 * w1[i] + b2 * w2[i]
      w2[i] = w1[i]
      w1[i] = w
    out1 = x
