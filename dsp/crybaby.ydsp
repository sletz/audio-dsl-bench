// ve.crybaby of Faust's vaeffects.lib (dm.crybaby_demo, examples/filtering/cryBaby.dsp), after
// dsp/crybaby.onda, without the bypass checkbox like crybaby.dsp. A biquad bandpass whose pole radius
// and angle follow the wah pedal, written on its state w and its output v = w - w'. The coefficients
// f2 = 1 + a1 + a2, fq = 1 - a2 and the gain go through si.smooth (error form), and f2 and fq get the
// correction ez = s^(n+1) (ma.FTZ applied) that makes smooth(1) start from 1. The parameter-only
// values are hoisted out of the sample loop by the optimiser.
processor CryBaby {
    input stream in1;
    output stream out1;
    input parameter float wah = 0.8 [[ min: 0.0, max: 1.0 ]];
    state float s;                          // smoothing pole
    state float imp;                        // 1 - 1': 1 on the first sample, then 0
    state float ei;                         // (+ : *(s)) ~ _ of the impulse: s^(n+1)
    state float gE, gXp, f2E, f2Xp, fqE, fqXp;     // si.smooth states (error and previous input)
    state float w;                          // direct form II state
    state float v;                          // output, v = w - w'

    init {
        s = pow (0.999, 44100.0 / sampleRate);
        imp = 1.0;
    }

    process {
        let wc = max (0.0, min (1.0, wah));
        let q = pow (2.0, 2.0 * (1.0 - wc) + 1.0);         // resonance quality factor
        let fr = 450.0 * pow (2.0, 2.3 * wc);              // resonance tuning
        let g = 0.1 * pow (4.0, wc) * 44100.0 / sampleRate;    // gain, peak referred to 44.1 kHz
        let frn = fr / sampleRate;
        let d = pi * frn / q;
        let sn = sin (pi * frn);
        let f2 = d * d + 4.0 * (1.0 - d) * (sn * sn);      // 1 + a1 + a2 = |1 - pole|^2
        let fq = d * (2.0 - d);                            // 1 - a2 = 1 - R^2

        ei = (imp + ei) * s;
        imp = 0.0;
        let ez = select (abs (ei) > 1.1754944e-38, ei, 0.0);   // ma.FTZ (e is a builtin constant)
        gE = s * (gE + (gXp - g));
        gXp = g;
        let gs = g + gE;
        f2E = s * (f2E + (f2Xp - f2));
        f2Xp = f2;
        let f2s = f2 + f2E + ez;
        fqE = s * (fqE + (fqXp - fq));
        fqXp = fq;
        let fqs = fq + fqE + ez;
        let vn = v + (gs * in1 - f2s * w - fqs * v);
        w = w + vn;
        v = vn;
        out1 = vn;
    }
}

graph Main {
    input stream in1;
    output stream out1;
    node p = CryBaby;
    connection { in1 -> p.in1; p.out1 -> out1; }
}
