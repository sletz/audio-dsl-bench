// Port of tapiir(6, 2) (examples/delayEcho/tapiir.dsp), after dsp/tapiir.dsp: 6 delay lines (de.delay,
// dsize = 524288) in a 6x6 feedback matrix, 2 inputs, 2 output mixers. The example's defaults are all 0;
// here tap i delays 0.05*(i+1) s (2400*(i+1) samples at 48 kHz), every tap gain is 0.1 (feedback matrix
// loop gain 0.6, output mixers 0.1 per tap), input gains 1, gains 1. Same sums in the same order as the
// C++ faust generates. The lines hold dsize samples (faust allocates 2^20 to reach a delay of dsize):
// the delay is clamped to dsize - 1, which the 5 s range never reaches at 48 kHz.
processor Tapiir {
    input stream in1;
    input stream in2;
    output stream out1;
    output stream out2;
    input parameter float t0_tap0 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float t0_tap1 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float t0_tap2 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float t0_tap3 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float t0_tap4 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float t0_tap5 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float t0_in0 = 1.0 [[ min: 0.0, max: 1.0 ]];
    input parameter float t0_in1 = 1.0 [[ min: 0.0, max: 1.0 ]];
    input parameter float t0_gain = 1.0 [[ min: 0.0, max: 1.0 ]];
    input parameter float t0_delay = 0.05 [[ min: 0.0, max: 5.0 ]];
    input parameter float t1_tap0 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float t1_tap1 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float t1_tap2 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float t1_tap3 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float t1_tap4 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float t1_tap5 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float t1_in0 = 1.0 [[ min: 0.0, max: 1.0 ]];
    input parameter float t1_in1 = 1.0 [[ min: 0.0, max: 1.0 ]];
    input parameter float t1_gain = 1.0 [[ min: 0.0, max: 1.0 ]];
    input parameter float t1_delay = 0.1 [[ min: 0.0, max: 5.0 ]];
    input parameter float t2_tap0 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float t2_tap1 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float t2_tap2 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float t2_tap3 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float t2_tap4 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float t2_tap5 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float t2_in0 = 1.0 [[ min: 0.0, max: 1.0 ]];
    input parameter float t2_in1 = 1.0 [[ min: 0.0, max: 1.0 ]];
    input parameter float t2_gain = 1.0 [[ min: 0.0, max: 1.0 ]];
    input parameter float t2_delay = 0.15 [[ min: 0.0, max: 5.0 ]];
    input parameter float t3_tap0 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float t3_tap1 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float t3_tap2 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float t3_tap3 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float t3_tap4 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float t3_tap5 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float t3_in0 = 1.0 [[ min: 0.0, max: 1.0 ]];
    input parameter float t3_in1 = 1.0 [[ min: 0.0, max: 1.0 ]];
    input parameter float t3_gain = 1.0 [[ min: 0.0, max: 1.0 ]];
    input parameter float t3_delay = 0.2 [[ min: 0.0, max: 5.0 ]];
    input parameter float t4_tap0 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float t4_tap1 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float t4_tap2 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float t4_tap3 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float t4_tap4 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float t4_tap5 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float t4_in0 = 1.0 [[ min: 0.0, max: 1.0 ]];
    input parameter float t4_in1 = 1.0 [[ min: 0.0, max: 1.0 ]];
    input parameter float t4_gain = 1.0 [[ min: 0.0, max: 1.0 ]];
    input parameter float t4_delay = 0.25 [[ min: 0.0, max: 5.0 ]];
    input parameter float t5_tap0 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float t5_tap1 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float t5_tap2 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float t5_tap3 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float t5_tap4 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float t5_tap5 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float t5_in0 = 1.0 [[ min: 0.0, max: 1.0 ]];
    input parameter float t5_in1 = 1.0 [[ min: 0.0, max: 1.0 ]];
    input parameter float t5_gain = 1.0 [[ min: 0.0, max: 1.0 ]];
    input parameter float t5_delay = 0.3 [[ min: 0.0, max: 5.0 ]];
    input parameter float o0_tap0 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float o0_tap1 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float o0_tap2 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float o0_tap3 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float o0_tap4 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float o0_tap5 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float o0_in0 = 1.0 [[ min: 0.0, max: 1.0 ]];
    input parameter float o0_in1 = 1.0 [[ min: 0.0, max: 1.0 ]];
    input parameter float o0_gain = 1.0 [[ min: 0.0, max: 1.0 ]];
    input parameter float o1_tap0 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float o1_tap1 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float o1_tap2 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float o1_tap3 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float o1_tap4 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float o1_tap5 = 0.1 [[ min: 0.0, max: 1.0 ]];
    input parameter float o1_in0 = 1.0 [[ min: 0.0, max: 1.0 ]];
    input parameter float o1_in1 = 1.0 [[ min: 0.0, max: 1.0 ]];
    input parameter float o1_gain = 1.0 [[ min: 0.0, max: 1.0 ]];

    state float b0[524288];
    state float b1[524288];
    state float b2[524288];
    state float b3[524288];
    state float b4[524288];
    state float b5[524288];
    state float y0, y1, y2, y3, y4, y5;   // line outputs, one sample late (the ~)
    state int w;                          // write position of every line

    process {
        let k0 = int (min (524287.0, max (0.0, sampleRate * t0_delay)));
        let k1 = int (min (524287.0, max (0.0, sampleRate * t1_delay)));
        let k2 = int (min (524287.0, max (0.0, sampleRate * t2_delay)));
        let k3 = int (min (524287.0, max (0.0, sampleRate * t3_delay)));
        let k4 = int (min (524287.0, max (0.0, sampleRate * t4_delay)));
        let k5 = int (min (524287.0, max (0.0, sampleRate * t5_delay)));
        let x0 = in1;
        let x1 = in2;
        b0[w] = t0_gain * (t0_in0 * x0 + t0_in1 * x1 + t0_tap0 * y0 + t0_tap1 * y1 + t0_tap2 * y2 + t0_tap3 * y3 + t0_tap4 * y4 + t0_tap5 * y5);
        let n0 = b0[(w - k0) & 524287];
        b1[w] = t1_gain * (t1_in0 * x0 + t1_in1 * x1 + t1_tap0 * y0 + t1_tap1 * y1 + t1_tap2 * y2 + t1_tap3 * y3 + t1_tap4 * y4 + t1_tap5 * y5);
        let n1 = b1[(w - k1) & 524287];
        b2[w] = t2_gain * (t2_in0 * x0 + t2_in1 * x1 + t2_tap0 * y0 + t2_tap1 * y1 + t2_tap2 * y2 + t2_tap3 * y3 + t2_tap4 * y4 + t2_tap5 * y5);
        let n2 = b2[(w - k2) & 524287];
        b3[w] = t3_gain * (t3_in0 * x0 + t3_in1 * x1 + t3_tap0 * y0 + t3_tap1 * y1 + t3_tap2 * y2 + t3_tap3 * y3 + t3_tap4 * y4 + t3_tap5 * y5);
        let n3 = b3[(w - k3) & 524287];
        b4[w] = t4_gain * (t4_in0 * x0 + t4_in1 * x1 + t4_tap0 * y0 + t4_tap1 * y1 + t4_tap2 * y2 + t4_tap3 * y3 + t4_tap4 * y4 + t4_tap5 * y5);
        let n4 = b4[(w - k4) & 524287];
        b5[w] = t5_gain * (t5_in0 * x0 + t5_in1 * x1 + t5_tap0 * y0 + t5_tap1 * y1 + t5_tap2 * y2 + t5_tap3 * y3 + t5_tap4 * y4 + t5_tap5 * y5);
        let n5 = b5[(w - k5) & 524287];
        y0 = n0;
        y1 = n1;
        y2 = n2;
        y3 = n3;
        y4 = n4;
        y5 = n5;
        out1 = o0_gain * (o0_in0 * x0 + o0_in1 * x1 + o0_tap0 * y0 + o0_tap1 * y1 + o0_tap2 * y2 + o0_tap3 * y3 + o0_tap4 * y4 + o0_tap5 * y5);
        out2 = o1_gain * (o1_in0 * x0 + o1_in1 * x1 + o1_tap0 * y0 + o1_tap1 * y1 + o1_tap2 * y2 + o1_tap3 * y3 + o1_tap4 * y4 + o1_tap5 * y5);
        w += 1;  if (w >= 524288) { w = 0; }
    }
}

graph Main {
    input stream in1;
    input stream in2;
    output stream out1;
    output stream out2;
    node p = Tapiir;
    connection { in1 -> p.in1; in2 -> p.in2; p.out1 -> out1; p.out2 -> out2; }
}
