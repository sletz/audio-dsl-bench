# Port of re.zita_rev1_stereo(60, f1, f2, t60dc, t60m, fsmax) from faustlibraries,
# delay lengths computed for 48 kHz exactly as reverbs.lib does (floor(0.5 + SR*t)).
ins 2
outs 2

params:
  f1 = 200.0 {50.0, 1000.0}
  f2 = 6000.0 {1500.0, 23520.0}
  t60dc = 3.0 {1.0, 8.0}
  t60m = 2.0 {1.0, 8.0}

namespace zr<M = 2>:
  struct Line:
    buf: f32[M]
    idx: i32 {M, wrap}

    def tick(self, w: f32):
      y = self.buf[self.idx]
      self.buf[self.idx] = w
      self.idx += 1
      return y

  # Schroeder allpass comb (fi.allpass_comb): u = x - a*u[n-M], y = u[n-M] + a*u
  struct Allpass:
    buf: f32[M]
    idx: i32 {M, wrap}

    def tick(self, x: f32, a: f32):
      r = self.buf[self.idx]
      u = x - a * r
      self.buf[self.idx] = u
      self.idx += 1
      return r + a * u

init:
  dl = zr<1920>::Line()        # input delay rdel - 20 = 40 ms
  dr = zr<1920>::Line()
  ap0 = zr<977>::Allpass()
  ap1 = zr<1172>::Allpass()
  ap2 = zr<1517>::Allpass()
  ap3 = zr<1312>::Allpass()
  ap4 = zr<1099>::Allpass()
  ap5 = zr<1406>::Allpass()
  ap6 = zr<646>::Allpass()
  ap7 = zr<918>::Allpass()
  fb0 = zr<6372>::Line()       # tdelay - apdelay - 1 (the loop adds one sample)
  fb1 = zr<8926>::Line()
  fb2 = zr<4618>::Line()
  fb3 = zr<11018>::Line()
  fb4 = zr<7286>::Line()
  fb5 = zr<7824>::Line()
  fb6 = zr<5353>::Line()
  fb7 = zr<9641>::Line()
  tdel: f32[8] = [7350.0, 10099.0, 6136.0, 12331.0, 8386.0, 9231.0, 6000.0, 10560.0]
  hp: f32[8]     # Hadamard outputs of the previous sample
  s1: f32[8]     # one-pole TPT lowpass states (low shelf)
  e: f32[8]      # si.smooth error states
  xp: f32[8]     # si.smooth previous inputs

block:
  g1 = tan(max(0.0, min(PI * f1 / SR, 0.499 * PI)))
  gk = g1 * (1.0 / (g1 + 1.0))
  gk2 = 2.0 * gk
  c = cos(TWO_PI * f2 / SR)
  if f2 > 0.49 * SR:
    c = -1.0
  shelf: f32[8]
  gm: f32[8]
  pole: f32[8]
  for i in 0..8:
    g0 = exp(-6.9077554 * tdel[i] / (t60dc * SR))
    gM = exp(-6.9077554 * tdel[i] / (t60m * SR))
    shelf[i] = g0 / gM - 1.0
    gm[i] = gM
    gs = gM * gM
    mbo2 = (1.0 - gs * c) / (1.0 - gs)
    pole[i] = mbo2 - sqrt(max(0.0, mbo2 * mbo2 - 1.0))
  t1 = 0.525 / sqrt(t60m)
  inv = 1.0 / sqrt(8.0)

  sample:
    # damping filters on the delayed Hadamard outputs
    z: f32[8]
    for i in 0..8:
      x = hp[i]
      d = x - s1[i]
      v = s1[i] + gk * d
      s1[i] = s1[i] + gk2 * d
      sh = gm[i] * (x + shelf[i] * v)
      e[i] = pole[i] * (e[i] + (xp[i] - sh))
      xp[i] = sh
      z[i] = inv * (sh + e[i]) + 0.00000000000000000001

    xl = 0.3 * dl.tick(in1)
    xr = 0.3 * dr.tick(in2)
    q0 = ap0.tick(fb0.tick(z[0]) + xl, 0.6)
    q1 = ap1.tick(fb1.tick(z[1]) + xl, -0.6)
    q2 = ap2.tick(fb2.tick(z[2]) - xl, 0.6)
    q3 = ap3.tick(fb3.tick(z[3]) - xl, -0.6)
    q4 = ap4.tick(fb4.tick(z[4]) + xr, 0.6)
    q5 = ap5.tick(fb5.tick(z[5]) + xr, -0.6)
    q6 = ap6.tick(fb6.tick(z[6]) - xr, 0.6)
    q7 = ap7.tick(fb7.tick(z[7]) - xr, -0.6)

    # ro.hadamard(8): butterfly(8), then hadamard(4) on each half
    b0 = q0 + q4
    b1 = q1 + q5
    b2 = q2 + q6
    b3 = q3 + q7
    b4 = q0 - q4
    b5 = q1 - q5
    b6 = q2 - q6
    b7 = q3 - q7
    c0 = b0 + b2
    c1 = b1 + b3
    c2 = b0 - b2
    c3 = b1 - b3
    c4 = b4 + b6
    c5 = b5 + b7
    c6 = b4 - b6
    c7 = b5 - b7
    hp[0] = c0 + c1
    hp[1] = c0 - c1
    hp[2] = c2 + c3
    hp[3] = c2 - c3
    hp[4] = c4 + c5
    hp[5] = c4 - c5
    hp[6] = c6 + c7
    hp[7] = c6 - c7
    out1 = (hp[1] + hp[2]) * t1
    out2 = (hp[1] - hp[2]) * t1
