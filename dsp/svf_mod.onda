ins 1
params:
  base = 800.0 {50.0, 5000.0}
  depth = 2.0 {0.0, 4.0}
  rate = 0.5 {0.01, 20.0}
  q = 2.0 {0.5, 20.0}

init:
  ph = 0.0
  ic1 = 0.0
  ic2 = 0.0

block:
  inc = rate / SR
  k = 1.0 / q
  sample:
    ph += inc
    ph -= floor(ph)
    lfo = sin(TWO_PI * ph)
    fc = base * pow(2.0, depth * lfo)
    g = tan(PI * fc / SR)
    a1 = 1.0 / (1.0 + g * (g + k))
    a2 = g * a1
    a3 = g * a2
    v3 = in1 - ic2
    v1 = a1 * ic1 + a2 * v3
    v2 = ic2 + a2 * ic1 + a3 * v3
    ic1 = 2.0 * v1 - ic1
    ic2 = 2.0 * v2 - ic2
    out1 = v2
