# dm.exciter (examples/psychoacoustic/harmonicExciter.dsp) ported to Onda, without the compressor
# bypass and the gain meter, like exciter.dsp. Wet path: fi.highpass(2, fc) (TPT SVF), then
# co.compressor_mono (an.amp_follower_ar = si.onePoleSwitching, in dB, gain computer, knee smoother
# si.smooth in error form, back to linear), pregain, asymmetric cubic harmonic creator, postgain;
# mixed with the dry input. Operations in the order of Faust's generated C++.
ins 1

params:
  ratio = 5.0 {1.0, 20.0}
  threshold = -30.0 {-100.0, 10.0}
  attack = 50.0 {0.0, 500.0}
  release = 500.0 {0.0, 1000.0}
  cutoff = 5000.0 {1000.0, 10000.0}
  harmonics = 20.0 {0.0000001192092896, 200.0}
  mix = 0.5 {0.0, 1.0}

init:
  s1 = 0.0                             # highpass SVF states
  s2 = 0.0
  env = 0.0                            # amp_follower_ar state
  gdbPrev = 0.0                        # knee smoother input, previous sample
  err = 0.0                            # knee smoother error state

block:
  t = 1.0 / SR
  dryGain = 1.0 - mix
  wetGain = 100.0 * (mix / harmonics)                    # postgain 1/ph, times the mix
  pre = 0.01 * harmonics                                 # pregain ph
  g = tan(max(0.0, min(PI / SR * cutoff, 1.5676547)))    # highpass SVF coefficients
  gk = g + 1.4142135
  c1 = g * min(340282346638528859811704183484516925440.0, 1.0 / (g * gk + 1.0))
  c2 = 2.0 * c1
  g2 = 2.0 * g
  slope = 1.0 / max(0.0000001192092896, ratio) + -1.0    # 1/max(ma.EPSILON, ratio) - 1
  poleRel = exp(-(t / max(t, 0.001 * release)))         # ba.tau2pole(rel)
  att = max(t, 0.001 * attack)                           # attack in s, at least one sample
  poleAtt = exp(-(t / att))                              # ba.tau2pole(att)
  poleKnee = exp(-(t / (0.5 * att)))                     # ba.tau2pole(att/2)
  sample:
    x = in1
    # fi.highpass(2, fc)
    v = x - (gk * s1 + s2)
    s1n = s1 + c2 * v
    bp = s1 + c1 * v
    s2n = s2 + g2 * bp
    hp = x - (s2 + g * bp + 1.4142135 * bp)
    s1 = s1n
    s2 = s2n
    # co.compressor_mono
    a = abs(hp)
    c = poleRel
    if a > env:
      c = poleAtt
    env = a * (1.0 - c) + env * c
    # ba.linear2db: 20*log10(max(ma.MIN, env)), log10 written log * 1/ln(10) (no log10 in Onda)
    gdb = slope * max(20.0 * (log(max(0.00000000000000000000000000000000000001175494351, env)) * 0.4342944819) - threshold, 0.0)
    err = poleKnee * (err + min(340282346638528859811704183484516925440.0, gdbPrev - gdb))
    gdbPrev = gdb
    comp = hp * pow(10.0, 0.05 * (gdb + err))
    # pregain and harmonic creator: x for x < 0, x - x^3/3 on [0, 1], 2/3 above 1
    p = pre * comp
    h = p * f32(p < 0.0) + f32(p >= 0.0) * f32(p <= 1.0) * (p - 0.33333334 * (p * p * p)) + 0.33333334 * f32(2 * i32(p > 1.0))
    out1 = dryGain * x + wetGain * h
