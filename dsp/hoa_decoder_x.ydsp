// 2D ambisonic decoder, order 3 (7 channels: W, C1, S1, C2, S2, C3, S3) to 8 speakers,
// max-rE weights, matrix as literal constants as generated by a decoder toolbox.
// YDSP streams are scalars in a sample body and cannot be gathered in an array: one dot product per speaker.
processor HoaDecoder {
    input stream in1;
    input stream in2;
    input stream in3;
    input stream in4;
    input stream in5;
    input stream in6;
    input stream in7;
    output stream out1;
    output stream out2;
    output stream out3;
    output stream out4;
    output stream out5;
    output stream out6;
    output stream out7;
    output stream out8;
    state float m[] = {
        0.125, 0.230969883, 0.0, 0.176776695, 0.0, 0.095670858, 0.0,
        0.125, 0.163320371, 0.163320371, 0.0, 0.176776695, -0.067649513, 0.067649513,
        0.125, 0.0, 0.230969883, -0.176776695, 0.0, 0.0, -0.095670858,
        0.125, -0.163320371, 0.163320371, 0.0, -0.176776695, 0.067649513, 0.067649513,
        0.125, -0.230969883, 0.0, 0.176776695, 0.0, -0.095670858, 0.0,
        0.125, -0.163320371, -0.163320371, 0.0, 0.176776695, 0.067649513, -0.067649513,
        0.125, 0.0, -0.230969883, -0.176776695, 0.0, 0.0, 0.095670858,
        0.125, 0.163320371, -0.163320371, 0.0, -0.176776695, -0.067649513, -0.067649513
    };

    process {
        out1 = m[0] * in1 + m[1] * in2 + m[2] * in3 + m[3] * in4 + m[4] * in5 + m[5] * in6 + m[6] * in7;
        out2 = m[7] * in1 + m[8] * in2 + m[9] * in3 + m[10] * in4 + m[11] * in5 + m[12] * in6 + m[13] * in7;
        out3 = m[14] * in1 + m[15] * in2 + m[16] * in3 + m[17] * in4 + m[18] * in5 + m[19] * in6 + m[20] * in7;
        out4 = m[21] * in1 + m[22] * in2 + m[23] * in3 + m[24] * in4 + m[25] * in5 + m[26] * in6 + m[27] * in7;
        out5 = m[28] * in1 + m[29] * in2 + m[30] * in3 + m[31] * in4 + m[32] * in5 + m[33] * in6 + m[34] * in7;
        out6 = m[35] * in1 + m[36] * in2 + m[37] * in3 + m[38] * in4 + m[39] * in5 + m[40] * in6 + m[41] * in7;
        out7 = m[42] * in1 + m[43] * in2 + m[44] * in3 + m[45] * in4 + m[46] * in5 + m[47] * in6 + m[48] * in7;
        out8 = m[49] * in1 + m[50] * in2 + m[51] * in3 + m[52] * in4 + m[53] * in5 + m[54] * in6 + m[55] * in7;
    }
}

graph Main {
    input stream in1;
    input stream in2;
    input stream in3;
    input stream in4;
    input stream in5;
    input stream in6;
    input stream in7;
    output stream out1;
    output stream out2;
    output stream out3;
    output stream out4;
    output stream out5;
    output stream out6;
    output stream out7;
    output stream out8;
    node p = HoaDecoder;
    connection {
        in1 -> p.in1; in2 -> p.in2; in3 -> p.in3; in4 -> p.in4; in5 -> p.in5; in6 -> p.in6; in7 -> p.in7;
        p.out1 -> out1; p.out2 -> out2; p.out3 -> out3; p.out4 -> out4; p.out5 -> out5; p.out6 -> out6; p.out7 -> out7; p.out8 -> out8;
    }
}
