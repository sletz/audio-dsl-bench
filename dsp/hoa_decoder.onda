# 2D ambisonic decoder, order 3 (7 channels: W, C1, S1, C2, S2, C3, S3) to 8 speakers,
# max-rE weights, matrix as literal constants as generated by a decoder toolbox.
ins 7
outs 8

const M: f32[56] = [
  0.125, 0.230969883, 0.0, 0.176776695, 0.0, 0.095670858, 0.0,
  0.125, 0.163320371, 0.163320371, 0.0, 0.176776695, -0.067649513, 0.067649513,
  0.125, 0.0, 0.230969883, -0.176776695, 0.0, 0.0, -0.095670858,
  0.125, -0.163320371, 0.163320371, 0.0, -0.176776695, 0.067649513, 0.067649513,
  0.125, -0.230969883, 0.0, 0.176776695, 0.0, -0.095670858, 0.0,
  0.125, -0.163320371, -0.163320371, 0.0, 0.176776695, 0.067649513, -0.067649513,
  0.125, 0.0, -0.230969883, -0.176776695, 0.0, 0.0, 0.095670858,
  0.125, 0.163320371, -0.163320371, 0.0, -0.176776695, -0.067649513, -0.067649513
]

sample:
  for k in 0..8:
    acc = M[k * 7] * ins[0]
    for j in 1..7:
      acc += M[k * 7 + j] * ins[j]
    outs[k] = acc
