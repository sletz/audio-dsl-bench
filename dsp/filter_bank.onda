    e3 = smoo * (e3 + min(340282346638528859811704183484516925440.0, xq3 - band3))
    xq3 = band3
    g3 = pow(10.0, 0.05 * (band3 + e3))
    e2 = smoo * (e2 + min(340282346638528859811704183484516925440.0, xq2 - band2))
    xq2 = band2
    g2 = pow(10.0, 0.05 * (band2 + e2))
    e1 = smoo * (e1 + min(340282346638528859811704183484516925440.0, xq1 - band1))
    xq1 = band1
    g1 = pow(10.0, 0.05 * (band1 + e1))
    y = p0_8y * g10 + p1_7y * g9 + p2_6y * g8 + p3_5y * g7 + p4_4y * g6 + p5_3y * g5 + p6_2y * g4 + p7_1y * g3 + hp1by * g2 + lp1bv2 * g1
    out1 = y
