    p5_2v1 = ga2 * p5_2u + p5_2s1
    p5_2v0 = ga2 * p5_2v1 + p5_2s0
    p5_2y = p5_2u - p5_2v1 + 0.38196602 * p5_2v0
    p5_2s1 = 2.0 * p5_2v1 - p5_2s1
    p5_2s0 = 2.0 * p5_2v0 - p5_2s0
    p5_3u = (p5_2y - p5_3s1 - 0.38196602 * (ga3 * p5_3s1 + p5_3s0)) * ra3
