    p2_6s0 = 2.0 * p2_6v0 - p2_6s0
    # band 3: delay-equalizing allpasses at fc(1) ... fc(5) (highpass_plus_lowpass, order 5)
    p3_1u = (hp6by - p3_1s1 - 0.38196602 * (ga1 * p3_1s1 + p3_1s0)) * ra1
    p3_1v1 = ga1 * p3_1u + p3_1s1
    p3_1v0 = ga1 * p3_1v1 + p3_1s0
    p3_1y = p3_1u - p3_1v1 + 0.38196602 * p3_1v0
    p3_1s1 = 2.0 * p3_1v1 - p3_1s1
