block:
  t1 = tan(max(0.0, min(122.71846 / SR, 1.5676547)))    # tan(PI*fc/SR), fc = 39.0625 Hz
  r1 = min(340282346638528859811704183484516925440.0, 1.0 / (1.0 + t1))
  gkA1 = t1 + 1.618034
  rA1 = min(340282346638528859811704183484516925440.0, 1.0 / (1.0 + t1 * gkA1))
  gkB1 = t1 + 0.618034
  rB1 = min(340282346638528859811704183484516925440.0, 1.0 / (1.0 + t1 * gkB1))
  ga1 = 1.618034 * t1
  ra1 = min(340282346638528859811704183484516925440.0, 1.0 / (1.0 + ga1 * (1.0 + ga1 * 0.38196602)))
  t2 = tan(max(0.0, min(245.43693 / SR, 1.5676547)))    # tan(PI*fc/SR), fc = 78.125 Hz
  r2 = min(340282346638528859811704183484516925440.0, 1.0 / (1.0 + t2))
  gkA2 = t2 + 1.618034
  rA2 = min(340282346638528859811704183484516925440.0, 1.0 / (1.0 + t2 * gkA2))
  gkB2 = t2 + 0.618034
  rB2 = min(340282346638528859811704183484516925440.0, 1.0 / (1.0 + t2 * gkB2))
  ga2 = 1.618034 * t2
  ra2 = min(340282346638528859811704183484516925440.0, 1.0 / (1.0 + ga2 * (1.0 + ga2 * 0.38196602)))
  t3 = tan(max(0.0, min(490.87385 / SR, 1.5676547)))    # tan(PI*fc/SR), fc = 156.25 Hz
  r3 = min(340282346638528859811704183484516925440.0, 1.0 / (1.0 + t3))
  gkA3 = t3 + 1.618034
  rA3 = min(340282346638528859811704183484516925440.0, 1.0 / (1.0 + t3 * gkA3))
  gkB3 = t3 + 0.618034
  rB3 = min(340282346638528859811704183484516925440.0, 1.0 / (1.0 + t3 * gkB3))
  ga3 = 1.618034 * t3
  ra3 = min(340282346638528859811704183484516925440.0, 1.0 / (1.0 + ga3 * (1.0 + ga3 * 0.38196602)))
  t4 = tan(max(0.0, min(981.7477 / SR, 1.5676547)))    # tan(PI*fc/SR), fc = 312.5 Hz
  r4 = min(340282346638528859811704183484516925440.0, 1.0 / (1.0 + t4))
  gkA4 = t4 + 1.618034
  rA4 = min(340282346638528859811704183484516925440.0, 1.0 / (1.0 + t4 * gkA4))
  gkB4 = t4 + 0.618034
  rB4 = min(340282346638528859811704183484516925440.0, 1.0 / (1.0 + t4 * gkB4))
  ga4 = 1.618034 * t4
  ra4 = min(340282346638528859811704183484516925440.0, 1.0 / (1.0 + ga4 * (1.0 + ga4 * 0.38196602)))
  t5 = tan(max(0.0, min(1963.4954 / SR, 1.5676547)))    # tan(PI*fc/SR), fc = 625 Hz
  r5 = min(340282346638528859811704183484516925440.0, 1.0 / (1.0 + t5))
  gkA5 = t5 + 1.618034
  rA5 = min(340282346638528859811704183484516925440.0, 1.0 / (1.0 + t5 * gkA5))
  gkB5 = t5 + 0.618034
  rB5 = min(340282346638528859811704183484516925440.0, 1.0 / (1.0 + t5 * gkB5))
  ga5 = 1.618034 * t5
  ra5 = min(340282346638528859811704183484516925440.0, 1.0 / (1.0 + ga5 * (1.0 + ga5 * 0.38196602)))
  t6 = tan(max(0.0, min(3926.9908 / SR, 1.5676547)))    # tan(PI*fc/SR), fc = 1250 Hz
  r6 = min(340282346638528859811704183484516925440.0, 1.0 / (1.0 + t6))
  gkA6 = t6 + 1.618034
  rA6 = min(340282346638528859811704183484516925440.0, 1.0 / (1.0 + t6 * gkA6))
  gkB6 = t6 + 0.618034
  rB6 = min(340282346638528859811704183484516925440.0, 1.0 / (1.0 + t6 * gkB6))
  ga6 = 1.618034 * t6
  ra6 = min(340282346638528859811704183484516925440.0, 1.0 / (1.0 + ga6 * (1.0 + ga6 * 0.38196602)))
  t7 = tan(max(0.0, min(7853.9816 / SR, 1.5676547)))    # tan(PI*fc/SR), fc = 2500 Hz
  c7 = 1.0 / t7
  csq7 = c7 * c7
  d7 = 1.0 + c7
  lp7b = 1.0 / d7
  hp7b = c7 / d7
  a7f = (1.0 - c7) / d7
  dA7 = 1.0 + 1.618034 * c7 + csq7
  a1A7 = 2.0 * (1.0 - csq7) / dA7
  a2A7 = (1.0 - 1.618034 * c7 + csq7) / dA7
  lpA7 = 1.0 / dA7
  hpA7 = csq7 / dA7
  dB7 = 1.0 + 0.618034 * c7 + csq7
  a1B7 = 2.0 * (1.0 - csq7) / dB7
  a2B7 = (1.0 - 0.618034 * c7 + csq7) / dB7
  lpB7 = 1.0 / dB7
  hpB7 = csq7 / dB7
  t8 = tan(max(0.0, min(15707.963 / SR, 1.5676547)))    # tan(PI*fc/SR), fc = 5000 Hz
  c8 = 1.0 / t8
  csq8 = c8 * c8
  d8 = 1.0 + c8
  lp8b = 1.0 / d8
  hp8b = c8 / d8
  a8f = (1.0 - c8) / d8
  dA8 = 1.0 + 1.618034 * c8 + csq8
  a1A8 = 2.0 * (1.0 - csq8) / dA8
  a2A8 = (1.0 - 1.618034 * c8 + csq8) / dA8
  lpA8 = 1.0 / dA8
  hpA8 = csq8 / dA8
  dB8 = 1.0 + 0.618034 * c8 + csq8
  a1B8 = 2.0 * (1.0 - csq8) / dB8
  a2B8 = (1.0 - 0.618034 * c8 + csq8) / dB8
  lpB8 = 1.0 / dB8
  hpB8 = csq8 / dB8
  t9 = tan(max(0.0, min(31415.927 / SR, 1.5676547)))    # tan(PI*fc/SR), fc = 10000 Hz
  c9 = 1.0 / t9
  csq9 = c9 * c9
  d9 = 1.0 + c9
  lp9b = 1.0 / d9
  hp9b = c9 / d9
  a9f = (1.0 - c9) / d9
  dA9 = 1.0 + 1.618034 * c9 + csq9
  a1A9 = 2.0 * (1.0 - csq9) / dA9
  a2A9 = (1.0 - 1.618034 * c9 + csq9) / dA9
  lpA9 = 1.0 / dA9
  hpA9 = csq9 / dA9
  dB9 = 1.0 + 0.618034 * c9 + csq9
  a1B9 = 2.0 * (1.0 - csq9) / dB9
  a2B9 = (1.0 - 0.618034 * c9 + csq9) / dB9
  lpB9 = 1.0 / dB9
  hpB9 = csq9 / dB9
  smoo = 1.0 - 44.1 / SR    # si.smoo pole
  sample:
    # analyzer: band i is hp(9-i) of the lowpassed signal, the dc band is lp(1)
    x = in1
    # hp(10000 Hz): tf1s_df, then tf2s_df with a1 = 1.618034 and a1 = 0.618034
    hp9y1 = hp9b * (x - xp9) - a9f * hp9y1
    hp9aw = hp9y1 - (a1A9 * hp9a1 + a2A9 * hp9a2)
    hp9ay = hpA9 * (hp9a2 + (hp9aw - 2.0 * hp9a1))
    hp9a2 = hp9a1
    hp9a1 = hp9aw
    hp9bw = hp9ay - (a1B9 * hp9b1 + a2B9 * hp9b2)
    hp9by = hpB9 * (hp9b2 + (hp9bw - 2.0 * hp9b1))
    hp9b2 = hp9b1
    hp9b1 = hp9bw
    # lp(10000 Hz): tf1s_df, then tf2s_df with a1 = 1.618034 and a1 = 0.618034
    lp9y1 = lp9b * (x + xp9) - a9f * lp9y1
    lp9aw = lp9y1 - (a1A9 * lp9a1 + a2A9 * lp9a2)
    lp9ay = lpA9 * (lp9a2 + lp9aw + 2.0 * lp9a1)
    lp9a2 = lp9a1
    lp9a1 = lp9aw
    lp9bw = lp9ay - (a1B9 * lp9b1 + a2B9 * lp9b2)
    lp9by = lpB9 * (lp9b2 + lp9bw + 2.0 * lp9b1)
    lp9b2 = lp9b1
    lp9b1 = lp9bw
    xp9 = x
    # hp(5000 Hz): tf1s_df, then tf2s_df with a1 = 1.618034 and a1 = 0.618034
    hp8y1 = hp8b * (lp9by - xp8) - a8f * hp8y1
    hp8aw = hp8y1 - (a1A8 * hp8a1 + a2A8 * hp8a2)
    hp8ay = hpA8 * (hp8a2 + (hp8aw - 2.0 * hp8a1))
    hp8a2 = hp8a1
    hp8a1 = hp8aw
    hp8bw = hp8ay - (a1B8 * hp8b1 + a2B8 * hp8b2)
    hp8by = hpB8 * (hp8b2 + (hp8bw - 2.0 * hp8b1))
    hp8b2 = hp8b1
    hp8b1 = hp8bw
    # lp(5000 Hz): tf1s_df, then tf2s_df with a1 = 1.618034 and a1 = 0.618034
    lp8y1 = lp8b * (lp9by + xp8) - a8f * lp8y1
    lp8aw = lp8y1 - (a1A8 * lp8a1 + a2A8 * lp8a2)
    lp8ay = lpA8 * (lp8a2 + lp8aw + 2.0 * lp8a1)
    lp8a2 = lp8a1
    lp8a1 = lp8aw
    lp8bw = lp8ay - (a1B8 * lp8b1 + a2B8 * lp8b2)
    lp8by = lpB8 * (lp8b2 + lp8bw + 2.0 * lp8b1)
    lp8b2 = lp8b1
    lp8b1 = lp8bw
    xp8 = lp9by
    # hp(2500 Hz): tf1s_df, then tf2s_df with a1 = 1.618034 and a1 = 0.618034
    hp7y1 = hp7b * (lp8by - xp7) - a7f * hp7y1
    hp7aw = hp7y1 - (a1A7 * hp7a1 + a2A7 * hp7a2)
    hp7ay = hpA7 * (hp7a2 + (hp7aw - 2.0 * hp7a1))
    hp7a2 = hp7a1
    hp7a1 = hp7aw
    hp7bw = hp7ay - (a1B7 * hp7b1 + a2B7 * hp7b2)
    hp7by = hpB7 * (hp7b2 + (hp7bw - 2.0 * hp7b1))
    hp7b2 = hp7b1
    hp7b1 = hp7bw
    # lp(2500 Hz): tf1s_df, then tf2s_df with a1 = 1.618034 and a1 = 0.618034
    lp7y1 = lp7b * (lp8by + xp7) - a7f * lp7y1
    lp7aw = lp7y1 - (a1A7 * lp7a1 + a2A7 * lp7a2)
    lp7ay = lpA7 * (lp7a2 + lp7aw + 2.0 * lp7a1)
    lp7a2 = lp7a1
    lp7a1 = lp7aw
    lp7bw = lp7ay - (a1B7 * lp7b1 + a2B7 * lp7b2)
