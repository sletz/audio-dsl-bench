    p6_2u = (p6_1y - p6_2s1 - 0.38196602 * (ga2 * p6_2s1 + p6_2s0)) * ra2
    p6_2v1 = ga2 * p6_2u + p6_2s1
    p6_2v0 = ga2 * p6_2v1 + p6_2s0
    p6_2y = p6_2u - p6_2v1 + 0.38196602 * p6_2v0
    p6_2s1 = 2.0 * p6_2v1 - p6_2s1
    p6_2s0 = 2.0 * p6_2v0 - p6_2s0
    # band 7: delay-equalizing allpasses at fc(1) ... fc(1) (highpass_plus_lowpass, order 5)
    p7_1u = (hp2by - p7_1s1 - 0.38196602 * (ga1 * p7_1s1 + p7_1s0)) * ra1
    p7_1v1 = ga1 * p7_1u + p7_1s1
    p7_1v0 = ga1 * p7_1v1 + p7_1s0
    p7_1y = p7_1u - p7_1v1 + 0.38196602 * p7_1v0
    p7_1s1 = 2.0 * p7_1v1 - p7_1s1
    p7_1s0 = 2.0 * p7_1v0 - p7_1s0
    # faders: si.smoo (error form) of each Band slider, ba.db2linear
    e10 = smoo * (e10 + min(340282346638528859811704183484516925440.0, xq10 - band10))
    xq10 = band10
    g10 = pow(10.0, 0.05 * (band10 + e10))
    e9 = smoo * (e9 + min(340282346638528859811704183484516925440.0, xq9 - band9))
    xq9 = band9
    g9 = pow(10.0, 0.05 * (band9 + e9))
    e8 = smoo * (e8 + min(340282346638528859811704183484516925440.0, xq8 - band8))
    xq8 = band8
    g8 = pow(10.0, 0.05 * (band8 + e8))
    e7 = smoo * (e7 + min(340282346638528859811704183484516925440.0, xq7 - band7))
