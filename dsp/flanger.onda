# dm.flanger_demo of Faust's demos.lib (examples/phasing/flanger.dsp) ported to Onda, like
# flanger.dsp: pf.flanger_stereo with dmax = 8192, invert off, no bypass. Each channel: a
# feedback comb (x + fb*y into a fractional delay line, de.fdelay: linear interpolation) whose
# delay follows a recursive quadrature LFO (fi.nlf2 driven by an impulse: os.oscrs on the left,
# os.oscrc on the right); the output is half the sum of the input and the delayed signal one
# sample late. The delay is written as the Faust compiler simplifies it.

params:
  flangeDelay = 10.0 {0.0, 20.0}
  delayOffset = 1.0 {0.0, 20.0}
  speed = 0.5 {0.0, 10.0}
  depth = 1.0 {0.0, 1.0}
  fb = 0.0 {-0.999, 0.999}
  level = 0.0 {-60.0, 10.0}

# A delay line of de.fdelay(8192, d): x written, then read d samples back (0 <= d <= 8193),
# linearly interpolated between the taps int(d) and int(d) + 1.
struct Line:
  buf: f32[16384]

  def tick(self, cursor: i32, x, d):
    self.buf[cursor] = x
    id = i32(min(8193.0, d))
    fl = floor(d)
    y = self.buf[(cursor - id) & 16383] * (1.0 - d + fl) + (d - fl) * self.buf[(cursor - min(
          8193,
          id + 1
      )) & 16383]
    return y

init:
  cursor = 0 {16384, wrap}
  lineL = Line()
  lineR = Line()
  oscS = 0.0  # fi.nlf2 states: sine (os.oscrs) ...
  oscC = 0.0  # ... and cosine (os.oscrc)
  imp = 1.0  # impulse driving fi.nlf2 (1 - 1')
  yl = 0.0  # delay line outputs, previous sample
  yr = 0.0

block:
  lvl = pow(10.0, 0.05 * level)  # ba.db2linear
  off = 0.001 * delayOffset  # delay in seconds: off + half * (1 + lfo)
  half = 0.0005 * flangeDelay
  w = TWO_PI / SR * speed
  sw = sin(w)
  cw = cos(w)
  sample:
    s = sw * oscC + cw * oscS
    c = imp - sw * oscS + cw * oscC
    oscS = s
    oscC = c
    imp = 0.0
    # left channel
    xl = lvl * in1
    dl = max(0.0, -1.0 + SR * (off + half * (1.0 + s)))  # de.fdelay(dmax, curdel - 1)
    nl = lineL.tick(cursor, xl + fb * yl, dl)
    out1 = 0.5 * (xl + depth * yl)
    yl = nl
    # right channel
    xr = lvl * in2
    dr = max(0.0, -1.0 + SR * (off + half * (1.0 + c)))
    nr = lineR.tick(cursor, xr + fb * yr, dr)
    out2 = 0.5 * (xr + depth * yr)
    yr = nr
    cursor += 1
