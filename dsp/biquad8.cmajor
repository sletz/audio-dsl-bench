// 8 identical RBJ lowpass biquads in series, direct form II. The filter state is in scalars
// rather than two float[8] (Cmajor JIT: 7.2 instead of 19.5 ns/sample; generated C++ unchanged).
processor Biquad8
{
    input stream float in1;
    output stream float out1;
    input event float cutoff [[ min: 20.0f, max: 20000.0f, init: 1000.0f ]];
    input event float q      [[ min: 0.1f,  max: 10.0f,    init: 0.707f ]];

    float cutoffV = 1000.0f, qV = 0.707f;
    float b0, b1, b2, a1, a2;
    float w1_0, w2_0, w1_1, w2_1, w1_2, w2_2, w1_3, w2_3, w1_4, w2_4, w1_5, w2_5, w1_6, w2_6, w1_7, w2_7;

    event cutoff (float v) { cutoffV = v; update(); }
    event q (float v)      { qV = v; update(); }

    void update()
    {
        let w0 = float (twoPi) * cutoffV / float (processor.frequency);
        let alpha = sin (w0) / (2.0f * qV);
        let cw = cos (w0);
        let a0 = 1.0f + alpha;
        b0 = (1.0f - cw) * 0.5f / a0;
        b1 = (1.0f - cw) / a0;
        b2 = b0;
        a1 = -2.0f * cw / a0;
        a2 = (1.0f - alpha) / a0;
    }

    void init() { update(); }

    void main()
    {
        loop
        {
            var x = in1;
            {
                let w = x + (-a1 * w1_0 - a2 * w2_0);
                x = b0 * w + b1 * w1_0 + b2 * w2_0;
                w2_0 = w1_0;
                w1_0 = w;
            }
            {
                let w = x + (-a1 * w1_1 - a2 * w2_1);
                x = b0 * w + b1 * w1_1 + b2 * w2_1;
                w2_1 = w1_1;
                w1_1 = w;
            }
            {
                let w = x + (-a1 * w1_2 - a2 * w2_2);
                x = b0 * w + b1 * w1_2 + b2 * w2_2;
                w2_2 = w1_2;
                w1_2 = w;
            }
            {
                let w = x + (-a1 * w1_3 - a2 * w2_3);
                x = b0 * w + b1 * w1_3 + b2 * w2_3;
                w2_3 = w1_3;
                w1_3 = w;
            }
            {
                let w = x + (-a1 * w1_4 - a2 * w2_4);
                x = b0 * w + b1 * w1_4 + b2 * w2_4;
                w2_4 = w1_4;
                w1_4 = w;
            }
            {
                let w = x + (-a1 * w1_5 - a2 * w2_5);
                x = b0 * w + b1 * w1_5 + b2 * w2_5;
                w2_5 = w1_5;
                w1_5 = w;
            }
            {
                let w = x + (-a1 * w1_6 - a2 * w2_6);
                x = b0 * w + b1 * w1_6 + b2 * w2_6;
                w2_6 = w1_6;
                w1_6 = w;
            }
            {
                let w = x + (-a1 * w1_7 - a2 * w2_7);
                x = b0 * w + b1 * w1_7 + b2 * w2_7;
                w2_7 = w1_7;
                w1_7 = w;
            }
            out1 <- x;
            advance();
        }
    }
}
