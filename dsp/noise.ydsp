// Linear congruential noise (Faust's no.noise) through a one-pole lowpass.
// YDSP integer arithmetic saturates: the wrapping product is computed in int64 and truncated.
processor Noise {
    output stream out1;
    input parameter float damp = 0.9 [[ min: 0.0, max: 0.999 ]];
    state int seed;
    state float lp;

    process {
        seed = int32 (int64 (seed) * 1103515245 + 12345);
        let x = float (seed) * (1.0 / 2147483647.0);
        lp = x * (1.0 - damp) + lp * damp;
        out1 = lp;
    }
}

graph Main {
    output stream out1;
    node p = Noise;
    connection { p.out1 -> out1; }
}
