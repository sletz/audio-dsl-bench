# 16-channel mixer: dB gain and constant-power pan per channel, master gain,
# written the direct way, everything in the sample loop.
ins 16

const def default_pan() -> f32[16]:
  values: f32[16]
  for channel in 0..16:
    values[channel] = f32(channel) / 15.0
  return values

params:
  gain: f32[16] = -6.0 {-60.0, 12.0}
  pan: f32[16] = default_pan() {0.0, 1.0}
  master = -3.0 {-60.0, 12.0}

sample:
  l = 0.0
  r = 0.0
  for i in 0..16:
    x = ins[i] * pow(10.0, gain[i] / 20.0)
    l += x * cos(pan[i] * PI * 0.5)
    r += x * sin(pan[i] * PI * 0.5)
  m = pow(10.0, master / 20.0)
  out1 = l * m
  out2 = r * m
