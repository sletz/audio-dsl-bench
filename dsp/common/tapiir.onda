const Capacity = 524288

def delay_frames(seconds):
  return i32(min(f32(Capacity - 1), max(0.0, SR * seconds)))

def ring_index(value: i32):
  index = value {Capacity, wrap}
  return index

init:
  b0: f32[Capacity]  # tap 0 line
  b1: f32[Capacity]
  b2: f32[Capacity]
  b3: f32[Capacity]
  b4: f32[Capacity]
  b5: f32[Capacity]
  w = 0 {Capacity, wrap}  # write position of every line
  y0 = 0.0  # line outputs, one sample late (the ~)
  y1 = 0.0
  y2 = 0.0
  y3 = 0.0
  y4 = 0.0
  y5 = 0.0
