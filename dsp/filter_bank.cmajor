// dm.filterbank_demo = dm.mth_octave_filterbank_demo(1) (examples/filtering/filterBank.dsp), after
// filter_bank.dsp: fi.mth_octave_filterbank_default(1, 10000, 10), each band through its fader
// (dB, si.smoo), summed; no bypass. Analyzer (an.mth_octave_analyzer_tpt_df): a dyadic tree of
// 5th-order Butterworth highpass/lowpass splits at 10000 * 2^(n-9) Hz, n = 9 ... 1, each a
// first-order section and two second-order ones (a1 = 1.618034, 0.618034); as in single-precision
// Faust (fi.tpt_df_fmin = 2304 Hz) the splits below 2304 Hz are trapezoidal (tf1s, svf.lp/hp) and
// the others direct form (tf1s_df, tf2s_df). Delay equalizer: band i goes through the allpasses
// fi.highpass_plus_lowpass(5, fc(j)) (tf2s(1,-1.618,1,1.618,1) or its direct form), j = 1 ... 8-i.
// All state is scalar and the network is written out in full.
processor FilterBank
{
    input stream float in1;
    output stream float out1;
    input event float band1 [[ min: -70.0f, max: 10.0f, init: -10.0f ]];
    input event float band2 [[ min: -70.0f, max: 10.0f, init: -10.0f ]];
    input event float band3 [[ min: -70.0f, max: 10.0f, init: -10.0f ]];
    input event float band4 [[ min: -70.0f, max: 10.0f, init: -10.0f ]];
    input event float band5 [[ min: -70.0f, max: 10.0f, init: -10.0f ]];
    input event float band6 [[ min: -70.0f, max: 10.0f, init: -10.0f ]];
    input event float band7 [[ min: -70.0f, max: 10.0f, init: -10.0f ]];
    input event float band8 [[ min: -70.0f, max: 10.0f, init: -10.0f ]];
    input event float band9 [[ min: -70.0f, max: 10.0f, init: -10.0f ]];
    input event float band10 [[ min: -70.0f, max: 10.0f, init: -10.0f ]];

    float band1V = -10.0f, band2V = -10.0f, band3V = -10.0f, band4V = -10.0f, band5V = -10.0f, band6V = -10.0f, band7V = -10.0f, band8V = -10.0f, band9V = -10.0f, band10V = -10.0f;
    // control-rate coefficients, recomputed by update()
    float t1, r1, gkA1, rA1, gkB1, rB1, ga1, ra1, t2, r2, gkA2, rA2;
    float gkB2, rB2, ga2, ra2, t3, r3, gkA3, rA3, gkB3, rB3, ga3, ra3;
    float t4, r4, gkA4, rA4, gkB4, rB4, ga4, ra4, t5, r5, gkA5, rA5;
    float gkB5, rB5, ga5, ra5, t6, r6, gkA6, rA6, gkB6, rB6, ga6, ra6;
    float lp7b, hp7b, a7f, a1A7, a2A7, lpA7, hpA7, a1B7, a2B7, lpB7, hpB7, lp8b;
    float hp8b, a8f, a1A8, a2A8, lpA8, hpA8, a1B8, a2B8, lpB8, hpB8, lp9b, hp9b;
    float a9f, a1A9, a2A9, lpA9, hpA9, a1B9, a2B9, lpB9, hpB9, smoo;
    // filter state
    float xp9;  // previous input of hp9 and lp9 (tf1s_df)
    float hp9y1, hp9a1, hp9a2, hp9b1, hp9b2;  // hp(10000 Hz), direct form: tf1 output, two biquad states
    float lp9y1, lp9a1, lp9a2, lp9b1, lp9b2;  // lp(10000 Hz), direct form: tf1 output, two biquad states
    float xp8;  // previous input of hp8 and lp8 (tf1s_df)
    float hp8y1, hp8a1, hp8a2, hp8b1, hp8b2;  // hp(5000 Hz), direct form: tf1 output, two biquad states
    float lp8y1, lp8a1, lp8a2, lp8b1, lp8b2;  // lp(5000 Hz), direct form: tf1 output, two biquad states
    float xp7;  // previous input of hp7 and lp7 (tf1s_df)
    float hp7y1, hp7a1, hp7a2, hp7b1, hp7b2;  // hp(2500 Hz), direct form: tf1 output, two biquad states
    float lp7y1, lp7a1, lp7a2, lp7b1, lp7b2;  // lp(2500 Hz), direct form: tf1 output, two biquad states
    float hp6s, hp6a1, hp6a2, hp6b1, hp6b2;  // hp(1250 Hz), TPT: tf1s state, two svf states
    float lp6s, lp6a1, lp6a2, lp6b1, lp6b2;  // lp(1250 Hz), TPT: tf1s state, two svf states
    float hp5s, hp5a1, hp5a2, hp5b1, hp5b2;  // hp(625 Hz), TPT: tf1s state, two svf states
    float lp5s, lp5a1, lp5a2, lp5b1, lp5b2;  // lp(625 Hz), TPT: tf1s state, two svf states
    float hp4s, hp4a1, hp4a2, hp4b1, hp4b2;  // hp(312.5 Hz), TPT: tf1s state, two svf states
    float lp4s, lp4a1, lp4a2, lp4b1, lp4b2;  // lp(312.5 Hz), TPT: tf1s state, two svf states
    float hp3s, hp3a1, hp3a2, hp3b1, hp3b2;  // hp(156.25 Hz), TPT: tf1s state, two svf states
    float lp3s, lp3a1, lp3a2, lp3b1, lp3b2;  // lp(156.25 Hz), TPT: tf1s state, two svf states
    float hp2s, hp2a1, hp2a2, hp2b1, hp2b2;  // hp(78.125 Hz), TPT: tf1s state, two svf states
    float lp2s, lp2a1, lp2a2, lp2b1, lp2b2;  // lp(78.125 Hz), TPT: tf1s state, two svf states
    float hp1s, hp1a1, hp1a2, hp1b1, hp1b2;  // hp(39.0625 Hz), TPT: tf1s state, two svf states
    float lp1s, lp1a1, lp1a2, lp1b1, lp1b2;  // lp(39.0625 Hz), TPT: tf1s state, two svf states
    float p0_1s1, p0_1s0;  // band 0 allpass at 39.0625 Hz, TPT (tf2s states)
    float p0_2s1, p0_2s0;  // band 0 allpass at 78.125 Hz, TPT (tf2s states)
    float p0_3s1, p0_3s0;  // band 0 allpass at 156.25 Hz, TPT (tf2s states)
    float p0_4s1, p0_4s0;  // band 0 allpass at 312.5 Hz, TPT (tf2s states)
    float p0_5s1, p0_5s0;  // band 0 allpass at 625 Hz, TPT (tf2s states)
    float p0_6s1, p0_6s0;  // band 0 allpass at 1250 Hz, TPT (tf2s states)
    float p0_7w1, p0_7w2;  // band 0 allpass at 2500 Hz, direct form
    float p0_8w1, p0_8w2;  // band 0 allpass at 5000 Hz, direct form
    float p1_1s1, p1_1s0;  // band 1 allpass at 39.0625 Hz, TPT (tf2s states)
    float p1_2s1, p1_2s0;  // band 1 allpass at 78.125 Hz, TPT (tf2s states)
    float p1_3s1, p1_3s0;  // band 1 allpass at 156.25 Hz, TPT (tf2s states)
    float p1_4s1, p1_4s0;  // band 1 allpass at 312.5 Hz, TPT (tf2s states)
    float p1_5s1, p1_5s0;  // band 1 allpass at 625 Hz, TPT (tf2s states)
    float p1_6s1, p1_6s0;  // band 1 allpass at 1250 Hz, TPT (tf2s states)
    float p1_7w1, p1_7w2;  // band 1 allpass at 2500 Hz, direct form
    float p2_1s1, p2_1s0;  // band 2 allpass at 39.0625 Hz, TPT (tf2s states)
    float p2_2s1, p2_2s0;  // band 2 allpass at 78.125 Hz, TPT (tf2s states)
    float p2_3s1, p2_3s0;  // band 2 allpass at 156.25 Hz, TPT (tf2s states)
    float p2_4s1, p2_4s0;  // band 2 allpass at 312.5 Hz, TPT (tf2s states)
    float p2_5s1, p2_5s0;  // band 2 allpass at 625 Hz, TPT (tf2s states)
    float p2_6s1, p2_6s0;  // band 2 allpass at 1250 Hz, TPT (tf2s states)
    float p3_1s1, p3_1s0;  // band 3 allpass at 39.0625 Hz, TPT (tf2s states)
    float p3_2s1, p3_2s0;  // band 3 allpass at 78.125 Hz, TPT (tf2s states)
    float p3_3s1, p3_3s0;  // band 3 allpass at 156.25 Hz, TPT (tf2s states)
    float p3_4s1, p3_4s0;  // band 3 allpass at 312.5 Hz, TPT (tf2s states)
    float p3_5s1, p3_5s0;  // band 3 allpass at 625 Hz, TPT (tf2s states)
    float p4_1s1, p4_1s0;  // band 4 allpass at 39.0625 Hz, TPT (tf2s states)
    float p4_2s1, p4_2s0;  // band 4 allpass at 78.125 Hz, TPT (tf2s states)
    float p4_3s1, p4_3s0;  // band 4 allpass at 156.25 Hz, TPT (tf2s states)
    float p4_4s1, p4_4s0;  // band 4 allpass at 312.5 Hz, TPT (tf2s states)
    float p5_1s1, p5_1s0;  // band 5 allpass at 39.0625 Hz, TPT (tf2s states)
    float p5_2s1, p5_2s0;  // band 5 allpass at 78.125 Hz, TPT (tf2s states)
    float p5_3s1, p5_3s0;  // band 5 allpass at 156.25 Hz, TPT (tf2s states)
    float p6_1s1, p6_1s0;  // band 6 allpass at 39.0625 Hz, TPT (tf2s states)
    float p6_2s1, p6_2s0;  // band 6 allpass at 78.125 Hz, TPT (tf2s states)
    float p7_1s1, p7_1s0;  // band 7 allpass at 39.0625 Hz, TPT (tf2s states)
    float e10, xq10;  // si.smoo of band10: error, previous input
    float e9, xq9;  // si.smoo of band9: error, previous input
    float e8, xq8;  // si.smoo of band8: error, previous input
    float e7, xq7;  // si.smoo of band7: error, previous input
    float e6, xq6;  // si.smoo of band6: error, previous input
    float e5, xq5;  // si.smoo of band5: error, previous input
    float e4, xq4;  // si.smoo of band4: error, previous input
    float e3, xq3;  // si.smoo of band3: error, previous input
    float e2, xq2;  // si.smoo of band2: error, previous input
    float e1, xq1;  // si.smoo of band1: error, previous input

    event band1 (float v) { band1V = v; }
    event band2 (float v) { band2V = v; }
    event band3 (float v) { band3V = v; }
    event band4 (float v) { band4V = v; }
    event band5 (float v) { band5V = v; }
    event band6 (float v) { band6V = v; }
    event band7 (float v) { band7V = v; }
    event band8 (float v) { band8V = v; }
    event band9 (float v) { band9V = v; }
    event band10 (float v) { band10V = v; }

    void update()
    {
        let sr = float (processor.frequency);
        t1 = tan (max (0.0f, min (122.71846f / sr, 1.5676547f)));  // tan(PI*fc/SR), fc = 39.0625 Hz
        r1 = min (3.4028235e38f, 1.0f / (1.0f + t1));
        gkA1 = t1 + 1.618034f;
        rA1 = min (3.4028235e38f, 1.0f / (1.0f + t1 * gkA1));
        gkB1 = t1 + 0.618034f;
        rB1 = min (3.4028235e38f, 1.0f / (1.0f + t1 * gkB1));
        ga1 = 1.618034f * t1;
        ra1 = min (3.4028235e38f, 1.0f / (1.0f + ga1 * (1.0f + ga1 * 0.38196602f)));
        t2 = tan (max (0.0f, min (245.43693f / sr, 1.5676547f)));  // tan(PI*fc/SR), fc = 78.125 Hz
        r2 = min (3.4028235e38f, 1.0f / (1.0f + t2));
        gkA2 = t2 + 1.618034f;
        rA2 = min (3.4028235e38f, 1.0f / (1.0f + t2 * gkA2));
        gkB2 = t2 + 0.618034f;
        rB2 = min (3.4028235e38f, 1.0f / (1.0f + t2 * gkB2));
        ga2 = 1.618034f * t2;
        ra2 = min (3.4028235e38f, 1.0f / (1.0f + ga2 * (1.0f + ga2 * 0.38196602f)));
        t3 = tan (max (0.0f, min (490.87385f / sr, 1.5676547f)));  // tan(PI*fc/SR), fc = 156.25 Hz
        r3 = min (3.4028235e38f, 1.0f / (1.0f + t3));
        gkA3 = t3 + 1.618034f;
        rA3 = min (3.4028235e38f, 1.0f / (1.0f + t3 * gkA3));
        gkB3 = t3 + 0.618034f;
        rB3 = min (3.4028235e38f, 1.0f / (1.0f + t3 * gkB3));
        ga3 = 1.618034f * t3;
        ra3 = min (3.4028235e38f, 1.0f / (1.0f + ga3 * (1.0f + ga3 * 0.38196602f)));
        t4 = tan (max (0.0f, min (981.7477f / sr, 1.5676547f)));  // tan(PI*fc/SR), fc = 312.5 Hz
        r4 = min (3.4028235e38f, 1.0f / (1.0f + t4));
        gkA4 = t4 + 1.618034f;
        rA4 = min (3.4028235e38f, 1.0f / (1.0f + t4 * gkA4));
        gkB4 = t4 + 0.618034f;
        rB4 = min (3.4028235e38f, 1.0f / (1.0f + t4 * gkB4));
        ga4 = 1.618034f * t4;
        ra4 = min (3.4028235e38f, 1.0f / (1.0f + ga4 * (1.0f + ga4 * 0.38196602f)));
        t5 = tan (max (0.0f, min (1963.4954f / sr, 1.5676547f)));  // tan(PI*fc/SR), fc = 625 Hz
        r5 = min (3.4028235e38f, 1.0f / (1.0f + t5));
        gkA5 = t5 + 1.618034f;
        rA5 = min (3.4028235e38f, 1.0f / (1.0f + t5 * gkA5));
        gkB5 = t5 + 0.618034f;
        rB5 = min (3.4028235e38f, 1.0f / (1.0f + t5 * gkB5));
        ga5 = 1.618034f * t5;
        ra5 = min (3.4028235e38f, 1.0f / (1.0f + ga5 * (1.0f + ga5 * 0.38196602f)));
        t6 = tan (max (0.0f, min (3926.9908f / sr, 1.5676547f)));  // tan(PI*fc/SR), fc = 1250 Hz
        r6 = min (3.4028235e38f, 1.0f / (1.0f + t6));
        gkA6 = t6 + 1.618034f;
        rA6 = min (3.4028235e38f, 1.0f / (1.0f + t6 * gkA6));
        gkB6 = t6 + 0.618034f;
        rB6 = min (3.4028235e38f, 1.0f / (1.0f + t6 * gkB6));
        ga6 = 1.618034f * t6;
        ra6 = min (3.4028235e38f, 1.0f / (1.0f + ga6 * (1.0f + ga6 * 0.38196602f)));
        let t7 = tan (max (0.0f, min (7853.9816f / sr, 1.5676547f)));  // tan(PI*fc/SR), fc = 2500 Hz
        let c7 = 1.0f / t7;
        let csq7 = c7 * c7;
        let d7 = 1.0f + c7;
        lp7b = 1.0f / d7;
        hp7b = c7 / d7;
        a7f = (1.0f - c7) / d7;
        let dA7 = 1.0f + 1.618034f * c7 + csq7;
        a1A7 = 2.0f * (1.0f - csq7) / dA7;
        a2A7 = (1.0f - 1.618034f * c7 + csq7) / dA7;
        lpA7 = 1.0f / dA7;
        hpA7 = csq7 / dA7;
        let dB7 = 1.0f + 0.618034f * c7 + csq7;
        a1B7 = 2.0f * (1.0f - csq7) / dB7;
        a2B7 = (1.0f - 0.618034f * c7 + csq7) / dB7;
        lpB7 = 1.0f / dB7;
        hpB7 = csq7 / dB7;
        let t8 = tan (max (0.0f, min (15707.963f / sr, 1.5676547f)));  // tan(PI*fc/SR), fc = 5000 Hz
        let c8 = 1.0f / t8;
        let csq8 = c8 * c8;
        let d8 = 1.0f + c8;
        lp8b = 1.0f / d8;
        hp8b = c8 / d8;
        a8f = (1.0f - c8) / d8;
        let dA8 = 1.0f + 1.618034f * c8 + csq8;
        a1A8 = 2.0f * (1.0f - csq8) / dA8;
        a2A8 = (1.0f - 1.618034f * c8 + csq8) / dA8;
        lpA8 = 1.0f / dA8;
        hpA8 = csq8 / dA8;
        let dB8 = 1.0f + 0.618034f * c8 + csq8;
        a1B8 = 2.0f * (1.0f - csq8) / dB8;
        a2B8 = (1.0f - 0.618034f * c8 + csq8) / dB8;
        lpB8 = 1.0f / dB8;
        hpB8 = csq8 / dB8;
        let t9 = tan (max (0.0f, min (31415.927f / sr, 1.5676547f)));  // tan(PI*fc/SR), fc = 10000 Hz
        let c9 = 1.0f / t9;
        let csq9 = c9 * c9;
        let d9 = 1.0f + c9;
        lp9b = 1.0f / d9;
        hp9b = c9 / d9;
        a9f = (1.0f - c9) / d9;
        let dA9 = 1.0f + 1.618034f * c9 + csq9;
        a1A9 = 2.0f * (1.0f - csq9) / dA9;
        a2A9 = (1.0f - 1.618034f * c9 + csq9) / dA9;
        lpA9 = 1.0f / dA9;
        hpA9 = csq9 / dA9;
        let dB9 = 1.0f + 0.618034f * c9 + csq9;
        a1B9 = 2.0f * (1.0f - csq9) / dB9;
        a2B9 = (1.0f - 0.618034f * c9 + csq9) / dB9;
        lpB9 = 1.0f / dB9;
        hpB9 = csq9 / dB9;
        smoo = 1.0f - 44.1f / sr;  // si.smoo pole
    }

    void init() { update(); }

    void main()
    {
        loop
        {
            // analyzer: band i is hp(9-i) of the lowpassed signal, the dc band is lp(1)
            let x = in1;
            // hp(10000 Hz): tf1s_df, then tf2s_df with a1 = 1.618034 and a1 = 0.618034
            hp9y1 = hp9b * (x - xp9) - a9f * hp9y1;
            let hp9aw = hp9y1 - (a1A9 * hp9a1 + a2A9 * hp9a2);
            let hp9ay = hpA9 * (hp9a2 + (hp9aw - 2.0f * hp9a1));
            hp9a2 = hp9a1;
            hp9a1 = hp9aw;
            let hp9bw = hp9ay - (a1B9 * hp9b1 + a2B9 * hp9b2);
            let hp9by = hpB9 * (hp9b2 + (hp9bw - 2.0f * hp9b1));
            hp9b2 = hp9b1;
            hp9b1 = hp9bw;
            // lp(10000 Hz): tf1s_df, then tf2s_df with a1 = 1.618034 and a1 = 0.618034
            lp9y1 = lp9b * (x + xp9) - a9f * lp9y1;
            let lp9aw = lp9y1 - (a1A9 * lp9a1 + a2A9 * lp9a2);
            let lp9ay = lpA9 * (lp9a2 + lp9aw + 2.0f * lp9a1);
            lp9a2 = lp9a1;
            lp9a1 = lp9aw;
            let lp9bw = lp9ay - (a1B9 * lp9b1 + a2B9 * lp9b2);
            let lp9by = lpB9 * (lp9b2 + lp9bw + 2.0f * lp9b1);
            lp9b2 = lp9b1;
            lp9b1 = lp9bw;
            xp9 = x;
            // hp(5000 Hz): tf1s_df, then tf2s_df with a1 = 1.618034 and a1 = 0.618034
            hp8y1 = hp8b * (lp9by - xp8) - a8f * hp8y1;
            let hp8aw = hp8y1 - (a1A8 * hp8a1 + a2A8 * hp8a2);
            let hp8ay = hpA8 * (hp8a2 + (hp8aw - 2.0f * hp8a1));
            hp8a2 = hp8a1;
            hp8a1 = hp8aw;
            let hp8bw = hp8ay - (a1B8 * hp8b1 + a2B8 * hp8b2);
            let hp8by = hpB8 * (hp8b2 + (hp8bw - 2.0f * hp8b1));
            hp8b2 = hp8b1;
            hp8b1 = hp8bw;
            // lp(5000 Hz): tf1s_df, then tf2s_df with a1 = 1.618034 and a1 = 0.618034
            lp8y1 = lp8b * (lp9by + xp8) - a8f * lp8y1;
            let lp8aw = lp8y1 - (a1A8 * lp8a1 + a2A8 * lp8a2);
            let lp8ay = lpA8 * (lp8a2 + lp8aw + 2.0f * lp8a1);
            lp8a2 = lp8a1;
            lp8a1 = lp8aw;
            let lp8bw = lp8ay - (a1B8 * lp8b1 + a2B8 * lp8b2);
            let lp8by = lpB8 * (lp8b2 + lp8bw + 2.0f * lp8b1);
            lp8b2 = lp8b1;
            lp8b1 = lp8bw;
            xp8 = lp9by;
            // hp(2500 Hz): tf1s_df, then tf2s_df with a1 = 1.618034 and a1 = 0.618034
            hp7y1 = hp7b * (lp8by - xp7) - a7f * hp7y1;
            let hp7aw = hp7y1 - (a1A7 * hp7a1 + a2A7 * hp7a2);
            let hp7ay = hpA7 * (hp7a2 + (hp7aw - 2.0f * hp7a1));
            hp7a2 = hp7a1;
            hp7a1 = hp7aw;
            let hp7bw = hp7ay - (a1B7 * hp7b1 + a2B7 * hp7b2);
            let hp7by = hpB7 * (hp7b2 + (hp7bw - 2.0f * hp7b1));
            hp7b2 = hp7b1;
            hp7b1 = hp7bw;
            // lp(2500 Hz): tf1s_df, then tf2s_df with a1 = 1.618034 and a1 = 0.618034
            lp7y1 = lp7b * (lp8by + xp7) - a7f * lp7y1;
            let lp7aw = lp7y1 - (a1A7 * lp7a1 + a2A7 * lp7a2);
            let lp7ay = lpA7 * (lp7a2 + lp7aw + 2.0f * lp7a1);
            lp7a2 = lp7a1;
            lp7a1 = lp7aw;
