            p2_3s1 = 2.0f * p2_3v1 - p2_3s1;
            p2_3s0 = 2.0f * p2_3v0 - p2_3s0;
            let p2_4u = (p2_3y - p2_4s1 - 0.38196602f * (ga4 * p2_4s1 + p2_4s0)) * ra4;
            let p2_4v1 = ga4 * p2_4u + p2_4s1;
            let p2_4v0 = ga4 * p2_4v1 + p2_4s0;
            let p2_4y = p2_4u - p2_4v1 + 0.38196602f * p2_4v0;
            p2_4s1 = 2.0f * p2_4v1 - p2_4s1;
            p2_4s0 = 2.0f * p2_4v0 - p2_4s0;
            let p2_5u = (p2_4y - p2_5s1 - 0.38196602f * (ga5 * p2_5s1 + p2_5s0)) * ra5;
            let p2_5v1 = ga5 * p2_5u + p2_5s1;
            let p2_5v0 = ga5 * p2_5v1 + p2_5s0;
            let p2_5y = p2_5u - p2_5v1 + 0.38196602f * p2_5v0;
            p2_5s1 = 2.0f * p2_5v1 - p2_5s1;
            p2_5s0 = 2.0f * p2_5v0 - p2_5s0;
            let p2_6u = (p2_5y - p2_6s1 - 0.38196602f * (ga6 * p2_6s1 + p2_6s0)) * ra6;
            let p2_6v1 = ga6 * p2_6u + p2_6s1;
            let p2_6v0 = ga6 * p2_6v1 + p2_6s0;
            let p2_6y = p2_6u - p2_6v1 + 0.38196602f * p2_6v0;
            p2_6s1 = 2.0f * p2_6v1 - p2_6s1;
            p2_6s0 = 2.0f * p2_6v0 - p2_6s0;
            // band 3: delay-equalizing allpasses at fc(1) ... fc(5) (highpass_plus_lowpass, order 5)
            let p3_1u = (hp6by - p3_1s1 - 0.38196602f * (ga1 * p3_1s1 + p3_1s0)) * ra1;
            let p3_1v1 = ga1 * p3_1u + p3_1s1;
            let p3_1v0 = ga1 * p3_1v1 + p3_1s0;
            let p3_1y = p3_1u - p3_1v1 + 0.38196602f * p3_1v0;
            p3_1s1 = 2.0f * p3_1v1 - p3_1s1;
            p3_1s0 = 2.0f * p3_1v0 - p3_1s0;
            let p3_2u = (p3_1y - p3_2s1 - 0.38196602f * (ga2 * p3_2s1 + p3_2s0)) * ra2;
            let p3_2v1 = ga2 * p3_2u + p3_2s1;
            let p3_2v0 = ga2 * p3_2v1 + p3_2s0;
            let p3_2y = p3_2u - p3_2v1 + 0.38196602f * p3_2v0;
            p3_2s1 = 2.0f * p3_2v1 - p3_2s1;
            p3_2s0 = 2.0f * p3_2v0 - p3_2s0;
            let p3_3u = (p3_2y - p3_3s1 - 0.38196602f * (ga3 * p3_3s1 + p3_3s0)) * ra3;
            let p3_3v1 = ga3 * p3_3u + p3_3s1;
            let p3_3v0 = ga3 * p3_3v1 + p3_3s0;
            let p3_3y = p3_3u - p3_3v1 + 0.38196602f * p3_3v0;
            p3_3s1 = 2.0f * p3_3v1 - p3_3s1;
            p3_3s0 = 2.0f * p3_3v0 - p3_3s0;
            let p3_4u = (p3_3y - p3_4s1 - 0.38196602f * (ga4 * p3_4s1 + p3_4s0)) * ra4;
            let p3_4v1 = ga4 * p3_4u + p3_4s1;
            let p3_4v0 = ga4 * p3_4v1 + p3_4s0;
            let p3_4y = p3_4u - p3_4v1 + 0.38196602f * p3_4v0;
            p3_4s1 = 2.0f * p3_4v1 - p3_4s1;
            p3_4s0 = 2.0f * p3_4v0 - p3_4s0;
            let p3_5u = (p3_4y - p3_5s1 - 0.38196602f * (ga5 * p3_5s1 + p3_5s0)) * ra5;
            let p3_5v1 = ga5 * p3_5u + p3_5s1;
            let p3_5v0 = ga5 * p3_5v1 + p3_5s0;
            let p3_5y = p3_5u - p3_5v1 + 0.38196602f * p3_5v0;
            p3_5s1 = 2.0f * p3_5v1 - p3_5s1;
            p3_5s0 = 2.0f * p3_5v0 - p3_5s0;
            // band 4: delay-equalizing allpasses at fc(1) ... fc(4) (highpass_plus_lowpass, order 5)
            let p4_1u = (hp5by - p4_1s1 - 0.38196602f * (ga1 * p4_1s1 + p4_1s0)) * ra1;
            let p4_1v1 = ga1 * p4_1u + p4_1s1;
            let p4_1v0 = ga1 * p4_1v1 + p4_1s0;
            let p4_1y = p4_1u - p4_1v1 + 0.38196602f * p4_1v0;
            p4_1s1 = 2.0f * p4_1v1 - p4_1s1;
            p4_1s0 = 2.0f * p4_1v0 - p4_1s0;
            let p4_2u = (p4_1y - p4_2s1 - 0.38196602f * (ga2 * p4_2s1 + p4_2s0)) * ra2;
            let p4_2v1 = ga2 * p4_2u + p4_2s1;
            let p4_2v0 = ga2 * p4_2v1 + p4_2s0;
            let p4_2y = p4_2u - p4_2v1 + 0.38196602f * p4_2v0;
            p4_2s1 = 2.0f * p4_2v1 - p4_2s1;
            p4_2s0 = 2.0f * p4_2v0 - p4_2s0;
            let p4_3u = (p4_2y - p4_3s1 - 0.38196602f * (ga3 * p4_3s1 + p4_3s0)) * ra3;
            let p4_3v1 = ga3 * p4_3u + p4_3s1;
            let p4_3v0 = ga3 * p4_3v1 + p4_3s0;
            let p4_3y = p4_3u - p4_3v1 + 0.38196602f * p4_3v0;
            p4_3s1 = 2.0f * p4_3v1 - p4_3s1;
            p4_3s0 = 2.0f * p4_3v0 - p4_3s0;
            let p4_4u = (p4_3y - p4_4s1 - 0.38196602f * (ga4 * p4_4s1 + p4_4s0)) * ra4;
            let p4_4v1 = ga4 * p4_4u + p4_4s1;
            let p4_4v0 = ga4 * p4_4v1 + p4_4s0;
            let p4_4y = p4_4u - p4_4v1 + 0.38196602f * p4_4v0;
            p4_4s1 = 2.0f * p4_4v1 - p4_4s1;
            p4_4s0 = 2.0f * p4_4v0 - p4_4s0;
            // band 5: delay-equalizing allpasses at fc(1) ... fc(3) (highpass_plus_lowpass, order 5)
            let p5_1u = (hp4by - p5_1s1 - 0.38196602f * (ga1 * p5_1s1 + p5_1s0)) * ra1;
            let p5_1v1 = ga1 * p5_1u + p5_1s1;
            let p5_1v0 = ga1 * p5_1v1 + p5_1s0;
            let p5_1y = p5_1u - p5_1v1 + 0.38196602f * p5_1v0;
            p5_1s1 = 2.0f * p5_1v1 - p5_1s1;
            p5_1s0 = 2.0f * p5_1v0 - p5_1s0;
            let p5_2u = (p5_1y - p5_2s1 - 0.38196602f * (ga2 * p5_2s1 + p5_2s0)) * ra2;
            let p5_2v1 = ga2 * p5_2u + p5_2s1;
            let p5_2v0 = ga2 * p5_2v1 + p5_2s0;
            let p5_2y = p5_2u - p5_2v1 + 0.38196602f * p5_2v0;
            p5_2s1 = 2.0f * p5_2v1 - p5_2s1;
            p5_2s0 = 2.0f * p5_2v0 - p5_2s0;
            let p5_3u = (p5_2y - p5_3s1 - 0.38196602f * (ga3 * p5_3s1 + p5_3s0)) * ra3;
            let p5_3v1 = ga3 * p5_3u + p5_3s1;
            let p5_3v0 = ga3 * p5_3v1 + p5_3s0;
            let p5_3y = p5_3u - p5_3v1 + 0.38196602f * p5_3v0;
            p5_3s1 = 2.0f * p5_3v1 - p5_3s1;
            p5_3s0 = 2.0f * p5_3v0 - p5_3s0;
            // band 6: delay-equalizing allpasses at fc(1) ... fc(2) (highpass_plus_lowpass, order 5)
            let p6_1u = (hp3by - p6_1s1 - 0.38196602f * (ga1 * p6_1s1 + p6_1s0)) * ra1;
            let p6_1v1 = ga1 * p6_1u + p6_1s1;
            let p6_1v0 = ga1 * p6_1v1 + p6_1s0;
            let p6_1y = p6_1u - p6_1v1 + 0.38196602f * p6_1v0;
            p6_1s1 = 2.0f * p6_1v1 - p6_1s1;
            p6_1s0 = 2.0f * p6_1v0 - p6_1s0;
            let p6_2u = (p6_1y - p6_2s1 - 0.38196602f * (ga2 * p6_2s1 + p6_2s0)) * ra2;
            let p6_2v1 = ga2 * p6_2u + p6_2s1;
            let p6_2v0 = ga2 * p6_2v1 + p6_2s0;
            let p6_2y = p6_2u - p6_2v1 + 0.38196602f * p6_2v0;
            p6_2s1 = 2.0f * p6_2v1 - p6_2s1;
            p6_2s0 = 2.0f * p6_2v0 - p6_2s0;
            // band 7: delay-equalizing allpasses at fc(1) ... fc(1) (highpass_plus_lowpass, order 5)
            let p7_1u = (hp2by - p7_1s1 - 0.38196602f * (ga1 * p7_1s1 + p7_1s0)) * ra1;
            let p7_1v1 = ga1 * p7_1u + p7_1s1;
            let p7_1v0 = ga1 * p7_1v1 + p7_1s0;
            let p7_1y = p7_1u - p7_1v1 + 0.38196602f * p7_1v0;
            p7_1s1 = 2.0f * p7_1v1 - p7_1s1;
            p7_1s0 = 2.0f * p7_1v0 - p7_1s0;
            // faders: si.smoo (error form) of each Band slider, ba.db2linear
            e10 = smoo * (e10 + min (3.4028235e38f, xq10 - band10V));
            xq10 = band10V;
            let g10 = pow (10.0f, 0.05f * (band10V + e10));
            e9 = smoo * (e9 + min (3.4028235e38f, xq9 - band9V));
            xq9 = band9V;
            let g9 = pow (10.0f, 0.05f * (band9V + e9));
            e8 = smoo * (e8 + min (3.4028235e38f, xq8 - band8V));
            xq8 = band8V;
            let g8 = pow (10.0f, 0.05f * (band8V + e8));
            e7 = smoo * (e7 + min (3.4028235e38f, xq7 - band7V));
            xq7 = band7V;
            let g7 = pow (10.0f, 0.05f * (band7V + e7));
            e6 = smoo * (e6 + min (3.4028235e38f, xq6 - band6V));
            xq6 = band6V;
            let g6 = pow (10.0f, 0.05f * (band6V + e6));
            e5 = smoo * (e5 + min (3.4028235e38f, xq5 - band5V));
            xq5 = band5V;
            let g5 = pow (10.0f, 0.05f * (band5V + e5));
            e4 = smoo * (e4 + min (3.4028235e38f, xq4 - band4V));
            xq4 = band4V;
            let g4 = pow (10.0f, 0.05f * (band4V + e4));
            e3 = smoo * (e3 + min (3.4028235e38f, xq3 - band3V));
            xq3 = band3V;
            let g3 = pow (10.0f, 0.05f * (band3V + e3));
            e2 = smoo * (e2 + min (3.4028235e38f, xq2 - band2V));
            xq2 = band2V;
            let g2 = pow (10.0f, 0.05f * (band2V + e2));
            e1 = smoo * (e1 + min (3.4028235e38f, xq1 - band1V));
            xq1 = band1V;
            let g1 = pow (10.0f, 0.05f * (band1V + e1));
            let y = p0_8y * g10 + p1_7y * g9 + p2_6y * g8 + p3_5y * g7 + p4_4y * g6 + p5_3y * g5 + p6_2y * g4 + p7_1y * g3 + hp1by * g2 + lp1bv2 * g1;
            out1 <- y;
            advance();
        }
    }
}
