// 32 Schroeder allpass combs in series (as fi.allpass_comb), alternating +-0.6.
// One processor: each line has its own array and a counter wrapped at a constant, which the
// optimiser proves in range.
processor Diffuser32 {
    input stream in1;
    output stream out1;
    state float b0[113];
    state int i0;
    state float b1[127];
    state int i1;
    state float b2[137];
    state int i2;
    state float b3[149];
    state int i3;
    state float b4[157];
    state int i4;
    state float b5[173];
    state int i5;
    state float b6[191];
    state int i6;
    state float b7[211];
    state int i7;
    state float b8[223];
    state int i8;
    state float b9[239];
    state int i9;
    state float b10[263];
    state int i10;
    state float b11[283];
    state int i11;
    state float b12[307];
    state int i12;
    state float b13[337];
    state int i13;
    state float b14[367];
    state int i14;
    state float b15[397];
    state int i15;
    state float b16[431];
    state int i16;
    state float b17[467];
    state int i17;
    state float b18[509];
    state int i18;
    state float b19[557];
    state int i19;
    state float b20[599];
    state int i20;
    state float b21[653];
    state int i21;
    state float b22[709];
    state int i22;
    state float b23[769];
    state int i23;
    state float b24[839];
    state int i24;
    state float b25[911];
    state int i25;
    state float b26[991];
    state int i26;
    state float b27[1087];
    state int i27;
    state float b28[1171];
    state int i28;
    state float b29[1277];
    state int i29;
    state float b30[1381];
    state int i30;
    state float b31[1499];
    state int i31;

    process {
        float x = in1;
        float r = 0.0;
        float u = 0.0;
        r = b0[i0]; u = x - (0.6) * r; b0[i0] = u;
        i0 += 1; if (i0 >= 113) { i0 = 0; }
        x = r + (0.6) * u;
        r = b1[i1]; u = x - (-0.6) * r; b1[i1] = u;
        i1 += 1; if (i1 >= 127) { i1 = 0; }
        x = r + (-0.6) * u;
        r = b2[i2]; u = x - (0.6) * r; b2[i2] = u;
        i2 += 1; if (i2 >= 137) { i2 = 0; }
        x = r + (0.6) * u;
        r = b3[i3]; u = x - (-0.6) * r; b3[i3] = u;
        i3 += 1; if (i3 >= 149) { i3 = 0; }
        x = r + (-0.6) * u;
        r = b4[i4]; u = x - (0.6) * r; b4[i4] = u;
        i4 += 1; if (i4 >= 157) { i4 = 0; }
        x = r + (0.6) * u;
        r = b5[i5]; u = x - (-0.6) * r; b5[i5] = u;
        i5 += 1; if (i5 >= 173) { i5 = 0; }
        x = r + (-0.6) * u;
        r = b6[i6]; u = x - (0.6) * r; b6[i6] = u;
        i6 += 1; if (i6 >= 191) { i6 = 0; }
        x = r + (0.6) * u;
        r = b7[i7]; u = x - (-0.6) * r; b7[i7] = u;
        i7 += 1; if (i7 >= 211) { i7 = 0; }
        x = r + (-0.6) * u;
        r = b8[i8]; u = x - (0.6) * r; b8[i8] = u;
        i8 += 1; if (i8 >= 223) { i8 = 0; }
        x = r + (0.6) * u;
        r = b9[i9]; u = x - (-0.6) * r; b9[i9] = u;
        i9 += 1; if (i9 >= 239) { i9 = 0; }
        x = r + (-0.6) * u;
        r = b10[i10]; u = x - (0.6) * r; b10[i10] = u;
        i10 += 1; if (i10 >= 263) { i10 = 0; }
        x = r + (0.6) * u;
        r = b11[i11]; u = x - (-0.6) * r; b11[i11] = u;
        i11 += 1; if (i11 >= 283) { i11 = 0; }
        x = r + (-0.6) * u;
        r = b12[i12]; u = x - (0.6) * r; b12[i12] = u;
        i12 += 1; if (i12 >= 307) { i12 = 0; }
        x = r + (0.6) * u;
        r = b13[i13]; u = x - (-0.6) * r; b13[i13] = u;
        i13 += 1; if (i13 >= 337) { i13 = 0; }
        x = r + (-0.6) * u;
        r = b14[i14]; u = x - (0.6) * r; b14[i14] = u;
        i14 += 1; if (i14 >= 367) { i14 = 0; }
        x = r + (0.6) * u;
        r = b15[i15]; u = x - (-0.6) * r; b15[i15] = u;
        i15 += 1; if (i15 >= 397) { i15 = 0; }
        x = r + (-0.6) * u;
        r = b16[i16]; u = x - (0.6) * r; b16[i16] = u;
        i16 += 1; if (i16 >= 431) { i16 = 0; }
        x = r + (0.6) * u;
        r = b17[i17]; u = x - (-0.6) * r; b17[i17] = u;
        i17 += 1; if (i17 >= 467) { i17 = 0; }
        x = r + (-0.6) * u;
        r = b18[i18]; u = x - (0.6) * r; b18[i18] = u;
        i18 += 1; if (i18 >= 509) { i18 = 0; }
        x = r + (0.6) * u;
        r = b19[i19]; u = x - (-0.6) * r; b19[i19] = u;
        i19 += 1; if (i19 >= 557) { i19 = 0; }
        x = r + (-0.6) * u;
        r = b20[i20]; u = x - (0.6) * r; b20[i20] = u;
        i20 += 1; if (i20 >= 599) { i20 = 0; }
        x = r + (0.6) * u;
        r = b21[i21]; u = x - (-0.6) * r; b21[i21] = u;
        i21 += 1; if (i21 >= 653) { i21 = 0; }
        x = r + (-0.6) * u;
        r = b22[i22]; u = x - (0.6) * r; b22[i22] = u;
        i22 += 1; if (i22 >= 709) { i22 = 0; }
        x = r + (0.6) * u;
        r = b23[i23]; u = x - (-0.6) * r; b23[i23] = u;
        i23 += 1; if (i23 >= 769) { i23 = 0; }
        x = r + (-0.6) * u;
        r = b24[i24]; u = x - (0.6) * r; b24[i24] = u;
        i24 += 1; if (i24 >= 839) { i24 = 0; }
        x = r + (0.6) * u;
        r = b25[i25]; u = x - (-0.6) * r; b25[i25] = u;
        i25 += 1; if (i25 >= 911) { i25 = 0; }
        x = r + (-0.6) * u;
        r = b26[i26]; u = x - (0.6) * r; b26[i26] = u;
        i26 += 1; if (i26 >= 991) { i26 = 0; }
        x = r + (0.6) * u;
        r = b27[i27]; u = x - (-0.6) * r; b27[i27] = u;
        i27 += 1; if (i27 >= 1087) { i27 = 0; }
        x = r + (-0.6) * u;
        r = b28[i28]; u = x - (0.6) * r; b28[i28] = u;
        i28 += 1; if (i28 >= 1171) { i28 = 0; }
        x = r + (0.6) * u;
        r = b29[i29]; u = x - (-0.6) * r; b29[i29] = u;
        i29 += 1; if (i29 >= 1277) { i29 = 0; }
        x = r + (-0.6) * u;
        r = b30[i30]; u = x - (0.6) * r; b30[i30] = u;
        i30 += 1; if (i30 >= 1381) { i30 = 0; }
        x = r + (0.6) * u;
        r = b31[i31]; u = x - (-0.6) * r; b31[i31] = u;
        i31 += 1; if (i31 >= 1499) { i31 = 0; }
        x = r + (-0.6) * u;
        out1 = x;
    }
}

graph Main {
    input stream in1;
    output stream out1;
    node p = Diffuser32;
    connection { in1 -> p.in1; p.out1 -> out1; }
}
