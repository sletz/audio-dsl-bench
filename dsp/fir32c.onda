ins 1

const def coeffs() -> f32[32]:
  values: f32[32]
  for i in 0..32:
    values[i] = sin(0.3 * f32(i + 1)) / f32(i + 1)
  return values

const C: f32[32] = coeffs()

init:
  h: f32[32]
  idx = 0 {32, wrap}

sample:
  h[idx] = in1
  acc = 0.0
  for i in 0..32:
    acc += C[i] * h[(idx - i) & 31]
  idx += 1
  out1 = acc
