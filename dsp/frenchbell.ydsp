// pm.frenchBell_ui of Faust's physmodels.lib (examples/physicalModeling/frenchBell.dsp), after
// dsp/frenchbell.onda, gate held at 1 like frenchbell.dsp: the bell is struck once. Strike
// (pm.strikeModel): noise through a 10 Hz highpass and a lowpass at strikeCutOff (TPT state variable
// filters), shaped by a triangular attack-release envelope (en.ar). Bell (pm.frenchBellModel):
// 50 modes (pm.modeFilter, Chamberlin form) in parallel, averaged. The mode loop works on parallel
// state arrays, which the optimiser vectorizes; the per-mode input gains are recomputed only when
// strikePosition changes.
processor FrenchBell {
    output stream out1;
    output stream out2;
    input parameter int strikePosition = 0 [[ min: 0, max: 6 ]];
    input parameter float strikeCutOff = 6500.0 [[ min: 20.0, max: 20000.0 ]];
    input parameter float strikeSharpness = 0.5 [[ min: 0.00999999978, max: 5.0 ]];
    input parameter float gain = 1.0 [[ min: 0.0, max: 1.0 ]];
    input parameter float gate = 1.0 [[ min: 0.0, max: 1.0 ]];

    // pm.modeFilter: 0.5*ln(1000)/t60 with t60 = 30*(1 - f/2555.3)^3, and pi*f, per mode
    state float decay[] = {
        0.202687562, 0.203040808, 0.259523958, 0.261662602, 0.305520266, 0.30564943, 0.392140836, 0.422799528,
        0.579614997, 0.580058396, 0.589833498, 0.591507912, 0.594091773, 0.685432851, 0.690533578, 0.766673744,
        0.771469116, 1.20678282, 1.24625671, 1.25343716, 1.69183767, 1.69671214, 2.15210032, 2.15801215,
        2.70792055, 2.73561692, 2.97851849, 3.00400162, 4.54476452, 4.61840248, 4.83327723, 5.40900278,
        7.17300463, 7.77074337, 13.6434813, 13.9355412, 15.3085737, 15.4016008, 17.7427902, 19.2863369,
        22.6243153, 24.4510536, 46.6008148, 48.3385239, 110.371704, 112.874847, 114.054665, 126.426628,
        559.485779, 613.32312
    };
    state float angle[] = {
        1379.40112, 1383.25891, 1905.2251, 1921.95093, 2229.32764, 2230.14429, 2692.23804, 2824.4519,
        3343.81689, 3345.01074, 3371.02319, 3375.42139, 3382.17578, 3598.44312, 3609.37573, 3760.76904,
        3769.62842, 4359.58789, 4398.73242, 4405.67529, 4750.27637, 4753.41797, 5002.89209, 5005.65674,
        5225.88232, 5235.37012, 5313.43848, 5321.13525, 5670.04053, 5682.63867, 5717.91846, 5802.96143,
        6002.73535, 6056.04834, 6393.36084, 6404.85938, 6454.90479, 6458.07764, 6530.39746, 6571.45801,
        6646.91895, 6682.19922, 6942.47998, 6955.64307, 7213.56787, 7219.63135, 7222.42725, 7249.60205,
        7553.771, 7568.06543
    };
    // modesGains of pm.frenchBellModel: 7 strike positions x 50 modes
    state float gains[] = {
        0.972890019, 0.542393029, 0.495831996, 0.897966027, 0.552366972, 0.557895005, 0.61421299, 0.353693992,
        0.436039001, 0.441024005, 0.674912989, 0.566753983, 0.755007982, 0.699029982, 0.164398, 0.910040021,
        0.628373027, 0.201718003, 0.429517001, 0.503714979, 0.871173978, 0.106885999, 0.76117301, 0.673601985,
        0.291936994, 0.588590026, 0.31527999, 0.41308099, 0.274464011, 0.494062006, 0.696120977, 0.612010002,
        0.382757008, 0.995113015, 0.228806004, 0.198449001, 0.595847011, 0.306263, 0.252397001, 0.0883567035,
        0.236085996, 1.0, 0.245278001, 0.379388005, 0.198824003, 0.548892021, 0.492763996, 0.42087099,
        0.794637024, 0.605633974, 1.0, 0.604158998, 0.399841011, 0.799346983, 0.507187009, 0.509809971,
        0.477382988, 0.310225993, 0.426975995, 0.437622994, 0.735711992, 0.630728006, 0.625784993, 0.651167989,
        0.277738005, 0.850857973, 0.578078985, 0.645353973, 0.383700013, 0.370597988, 0.78254199, 0.181325004,
        0.614391029, 0.740683973, 0.342440993, 0.586185992, 0.286909014, 0.405196995, 0.259214997, 0.566982985,
        0.748219013, 0.655897975, 0.368259996, 0.940814018, 0.336156994, 0.413702011, 0.561556995, 0.402175993,
        0.117697999, 0.329369009, 0.254570991, 0.870706022, 0.260980994, 0.274122, 0.206247002, 0.645299971,
        0.400757998, 0.36362201, 0.636834025, 0.584565997, 0.975602984, 0.616936982, 0.295401007, 0.650447011,
        0.464221001, 0.465056986, 0.312467009, 0.238358006, 0.383695006, 0.399673998, 0.753911972, 0.662011981,
        0.504267991, 0.599247992, 0.378665, 0.725363016, 0.493214011, 1.0, 0.332836002, 0.265888989,
        0.674072981, 0.320401013, 0.440017998, 0.769782007, 0.316419005, 0.529968023, 0.380508989, 0.578675985,
        0.249013007, 0.591383994, 0.761717021, 0.687057018, 0.324436992, 0.818863988, 0.505369008, 0.672484994,
        0.461782992, 0.426198006, 0.0678874999, 0.43532899, 0.347954988, 0.708393991, 0.293321997, 0.328985989,
        0.258253992, 0.893512011, 0.320131004, 0.433553994, 0.459302008, 0.542213023, 0.817241013, 0.516229987,
        0.205302, 0.467354, 0.388682991, 0.388215989, 0.171261996, 0.150865003, 0.291720003, 0.311414003,
        0.658876002, 0.570647001, 0.38361901, 0.502454996, 0.364113986, 0.532312989, 0.352988988, 1.0,
        0.261983991, 0.219591007, 0.544031024, 0.337199003, 0.279172987, 0.668303013, 0.208439007, 0.399230003,
        0.418673992, 0.648617983, 0.234133005, 0.504728973, 0.645346999, 0.572851002, 0.232828006, 0.614292026,
        0.48527199, 0.666263998, 0.316570014, 0.320354998, 0.191421002, 0.340131015, 0.342069, 0.538371027,
        0.281130999, 0.393115014, 0.251394004, 0.890725017, 0.310644001, 0.503700018, 0.299089998, 0.442478001,
        0.733128011, 0.455217004, 0.199322, 0.315699011, 0.375856012, 0.376489997, 0.0291450005, 0.0200283006,
        0.279578, 0.316799998, 0.655956984, 0.546842992, 0.349665999, 0.470248997, 0.353765011, 0.286794007,
        0.180185005, 1.0, 0.210831001, 0.280133009, 0.535853028, 0.376488, 0.153669998, 0.634745002,
        0.0510449, 0.485574991, 0.593110979, 0.917883992, 0.380477011, 0.422924995, 0.599372983, 0.311421007,
        0.135654002, 0.359954, 0.295747995, 0.474438995, 0.353338987, 0.116742998, 0.45431301, 0.112857997,
        0.359310001, 0.483897001, 0.301607996, 0.577341974, 0.262663007, 0.79498601, 0.549579978, 0.808085978,
        0.152511001, 0.439590991, 0.535941005, 0.308017999, 0.419836998, 0.579191029, 0.250427991, 0.252119988,
        0.102860004, 0.288331985, 0.599678993, 0.665108025, 0.636285007, 0.495234013, 0.251612991, 0.208526999,
        0.0939071998, 0.458415002, 0.318951994, 0.235349998, 0.215188995, 0.313412011, 0.0472786985, 0.0386893004,
        0.0863358974, 0.222345993, 0.361510992, 0.997036994, 0.238508999, 0.382140011, 1.0, 0.203554004,
        0.472086996, 0.509015024, 0.206370994, 0.441013008, 0.794008017, 0.971623003, 0.796383977, 0.55043,
        0.687780023, 0.554297984, 0.0436545014, 0.0595576987, 0.214684993, 0.581470013, 0.277319998, 0.36846599,
        0.121381998, 0.152739003, 0.0782243982, 0.190496996, 0.31626901, 0.180455998, 0.405196011, 0.518715978,
        0.159364998, 0.165808007, 0.194371998, 0.614763975, 0.553415, 0.644793987, 0.441780001, 0.441489995,
        0.221588001, 1.0, 0.579370975, 0.606338978, 0.529166996, 0.0214475002, 0.41704601, 0.663151979,
        0.894841015, 0.475751996, 0.168289006, 0.468589991, 0.304603994, 0.666369021, 0.308337003, 0.295091003,
        0.768944979, 0.350910991, 0.490680009, 0.516583979, 0.40011701, 0.820686996, 0.545485973, 0.709357023,
        0.509759009, 0.472005993, 0.152455002, 0.981265008, 0.459134012, 0.698665977, 0.247153997, 0.623252988,
        0.255508006, 0.830815017, 0.0887089968, 0.126082003, 0.0770623013, 0.263327986
    };
    state float gi[50];                 // input gain per mode, referred to 44.1 kHz
    state int giPosition;               // strikePosition gi was computed for, -1 before the first sample
    state float f2[50], qq1[50], op[50], b0[50];   // pm.modeFilter coefficients per mode
    state float low[50], band[50];      // mode states: lowpass / f and bandpass
    state int seed;                     // no.noise
    state float h1, h2, l1, l2;         // 10 Hz highpass and lowpass at strikeCutOff
    state float gatePrev;
    state int count;                    // en.ar: samples since the strike
    state float xp;                     // previous strike sample (the modes take x + x')
    state float gh, ghk, gh9, ch;

    init {
        for i in 0..50 {
            let t = tanh (decay[i] / sampleRate);
            let t2 = t * t;
            let s = sin (angle[i] / sampleRate);
            b0[i] = t2 + s * s * (1.0 - t2);
            op[i] = (t + 1.0) * (t + 1.0);
            f2[i] = min (4.0 * (b0[i] / op[i]), 3.4028235e38);
            qq1[i] = min (t / b0[i], 3.4028235e38) + 1.0;
        }
        giPosition = -1;
        gh = tan (max (0.0, min (pi * 10.0 / sampleRate, 1.5676547)));
        ghk = gh + 1.4142135;
        gh9 = -1.4142135 - gh;
        ch = gh * min (3.4028235e38, 1.0 / (gh * ghk + 1.0));
    }

    process {
        if (strikePosition != giPosition) {
            let p = 50 * clamp (strikePosition, 0, 6);
            for i in 0..50 {
                gi[i] = min (11025.0 / sampleRate * (op[i] * gains[p + i] / b0[i]), 3.4028235e38);
            }
            giPosition = strikePosition;
        }
        let gl = tan (max (0.0, min (pi / sampleRate * strikeCutOff, 1.5676547)));
        let glk = gl + 1.4142135;
        let cl = gl * min (3.4028235e38, 1.0 / (gl * glk + 1.0));
        let invAtt = 1.0 / max (1.0, 0.002 * sampleRate * strikeSharpness);

        // strike: noise -> highpass -> lowpass, times the attack-release envelope
        seed = int32 (int64 (seed) * 1103515245 + 12345);
        let n = 0.0000000004656613 * float (seed);
        let t1 = n - (ghk * h1 + h2);
        let v1 = h1 + ch * t1;
        let hp = n + gh9 * v1 - h2;
        h1 += 2.0 * ch * t1;
        h2 += 2.0 * gh * v1;
        let t3 = hp - (glk * l1 + l2);
        let w1 = l1 + cl * t3;
        let lp = l2 + gl * w1;
        l1 += 2.0 * cl * t3;
        l2 += 2.0 * gl * w1;
        let rise = select (gate > gatePrev, 1, 0);
        let keep = select (gate <= gatePrev, 1, 0);
        if (count > 0) { count = rise + (count + 1) * keep; } else { count = rise + count * keep; }
        gatePrev = gate;
        let tt = invAtt * float (count);
        let x = gain * lp * max (0.0, min (tt, 2.0 - tt));
        let xin = x + xp;
        xp = x;
        // the 50 modes
        for i in 0..50 {
            let l = low[i] + band[i];
            band[i] = band[i] + f2[i] * (gi[i] * xin - (low[i] + band[i] * qq1[i]));
            low[i] = l;
        }
        float acc = 0.0;
        for i in 0..50 { acc += band[i]; }
        out1 = 0.02 * acc;
        out2 = 0.02 * acc;
    }
}

graph Main {
    output stream out1;
    output stream out2;
    node p = FrenchBell;
    connection { p.out1 -> out1; p.out2 -> out2; }
}
