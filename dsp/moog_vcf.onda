# dm.moog_vcf_demo of Faust's demos.lib (examples/filtering/moogVCF.dsp) ported to onda, default
# branch only like moog_vcf.dsp: ve.moog_vcf(res^4, freq), four one-poles with (1 - p) at the input
# of each and a global feedback mk = -4 res^4, then the output gain. The corner frequency (piano
# keys to Hz) and the gain (dB to linear) go through si.smoo (si.smooth, error form).

params:
  freq = 25.0 {1.0, 88.0}
  res = 0.9 {0.0, 1.0}
  outgain = 5.0 {-60.0, 20.0}

init:
  c1 = TWO_PI / SR  # 2 pi / SR
  sp = 1.0 - 44.1 / SR  # si.smoo pole
  frE = 0.0  # si.smooth states (error and previous input)
  frXp = 0.0
  gE = 0.0
  gXp = 0.0
  y1 = 0.0  # the four one-pole states
  y2 = 0.0
  y3 = 0.0
  y4 = 0.0

block:
  frT = 440.0 * pow(2.0, (1.0 / 12.0) * (freq - 49.0))  # ba.pianokey2hz
  r4 = res * res * res * res
  mk = -4.0 * max(0.0, min(r4, 0.999999))  # need mk > -4 for stability
  gT = pow(10.0, 0.05 * outgain)  # ba.db2linear
  sample:
    frE = sp * (frE + (frXp - frT))
    frXp = frT
    fr = frT + frE
    # p = 1 - fr 2 pi / SR; 1 - p written fr 2 pi / SR, as faust simplifies it
    a = c1 * fr
    p = 1.0 - a
    y1 = p * y1 + a * (in1 + mk * y4)
    y2 = p * y2 + a * y1
    y3 = p * y3 + a * y2
    y4 = p * y4 + a * y3
    gE = sp * (gE + (gXp - gT))
    gXp = gT
    out1 = y4 * (gT + gE)
