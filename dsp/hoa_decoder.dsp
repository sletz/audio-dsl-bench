import("stdfaust.lib");
// 2D ambisonic decoder, order 3 (7 channels: W, C1, S1, C2, S2, C3, S3) to 8 speakers,
// max-rE weights, matrix as literal constants as generated by a decoder toolbox.
row0 = (0.125, 0.230969883, 0.0, 0.176776695, 0.0, 0.095670858, 0.0);
row1 = (0.125, 0.163320371, 0.163320371, 0.0, 0.176776695, -0.067649513, 0.067649513);
row2 = (0.125, 0.0, 0.230969883, -0.176776695, 0.0, 0.0, -0.095670858);
row3 = (0.125, -0.163320371, 0.163320371, 0.0, -0.176776695, 0.067649513, 0.067649513);
row4 = (0.125, -0.230969883, 0.0, 0.176776695, 0.0, -0.095670858, 0.0);
row5 = (0.125, -0.163320371, -0.163320371, 0.0, 0.176776695, 0.067649513, -0.067649513);
row6 = (0.125, 0.0, -0.230969883, -0.176776695, 0.0, 0.0, 0.095670858);
row7 = (0.125, 0.163320371, -0.163320371, 0.0, -0.176776695, -0.067649513, -0.067649513);
dec(row) = par(j, 7, *(ba.take(j+1, row))) :> _;
process = si.bus(7) <: dec(row0), dec(row1), dec(row2), dec(row3), dec(row4), dec(row5), dec(row6), dec(row7);
