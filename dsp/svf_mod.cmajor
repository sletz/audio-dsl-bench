// TPT state variable lowpass whose cutoff is swept by a sine LFO: coefficients per sample.
processor SvfMod
{
    input stream float in1;
    output stream float out1;
    input event float base  [[ min: 50.0f, max: 5000.0f, init: 800.0f ]];
    input event float depth [[ min: 0.0f,  max: 4.0f,    init: 2.0f ]];
    input event float rate  [[ min: 0.01f, max: 20.0f,   init: 0.5f ]];
    input event float q     [[ min: 0.5f,  max: 20.0f,   init: 2.0f ]];

    float baseV = 800.0f, depthV = 2.0f, rateV = 0.5f, qV = 2.0f;
    float inc, k, ph, ic1, ic2;

    event base (float v)  { baseV = v; }
    event depth (float v) { depthV = v; }
    event rate (float v)  { rateV = v; update(); }
    event q (float v)     { qV = v; update(); }

    void update()
    {
        inc = rateV / float (processor.frequency);
        k = 1.0f / qV;
    }

    void init() { update(); }

    void main()
    {
        let sr = float (processor.frequency);

        loop
        {
            ph += inc;
            ph -= floor (ph);
            let lfo = sin (float (twoPi) * ph);
            let fc = baseV * pow (2.0f, depthV * lfo);
            let g = tan (float (pi) * fc / sr);
            let a1 = 1.0f / (1.0f + g * (g + k));
            let a2 = g * a1;
            let a3 = g * a2;
            let v3 = in1 - ic2;
            let v1 = a1 * ic1 + a2 * v3;
            let v2 = ic2 + a2 * ic1 + a3 * v3;
            ic1 = 2.0f * v1 - ic1;
            ic2 = 2.0f * v2 - ic2;
            out1 <- v2;
            advance();
        }
    }
}
