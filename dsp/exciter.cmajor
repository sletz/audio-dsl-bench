// dm.exciter (examples/psychoacoustic/harmonicExciter.dsp), after dsp/exciter.onda, without the
// compressor bypass and the gain meter like exciter.dsp. Wet path: fi.highpass(2, fc) (TPT SVF),
// co.compressor_mono (one-pole attack/release detector, in dB, gain computer, knee smoother, back
// to linear), pregain, asymmetric cubic harmonic creator, postgain; mixed with the dry input.
processor Exciter
{
    input stream float in1;
    output stream float out1;
    input event float ratio     [[ min: 1.0f,    max: 20.0f,    init: 5.0f ]];
    input event float threshold [[ min: -100.0f, max: 10.0f,    init: -30.0f ]];
    input event float attack    [[ min: 0.0f,    max: 500.0f,   init: 50.0f ]];
    input event float release   [[ min: 0.0f,    max: 1000.0f,  init: 500.0f ]];
    input event float cutoff    [[ min: 1000.0f, max: 10000.0f, init: 5000.0f ]];
    input event float harmonics [[ min: 0.0000001192092896f, max: 200.0f, init: 20.0f ]];
    input event float mix       [[ min: 0.0f,    max: 1.0f,     init: 0.5f ]];

    float ratioV = 5.0f, thresholdV = -30.0f, attackV = 50.0f, releaseV = 500.0f;
    float cutoffV = 5000.0f, harmonicsV = 20.0f, mixV = 0.5f;
    float dryGain, wetGain, pre, g, gk, c1, c2, g2, slope, poleRel, poleAtt, poleKnee;
    float s1, s2, env, gdbPrev, err;

    event ratio (float v)     { ratioV = v; update(); }
    event threshold (float v) { thresholdV = v; }
    event attack (float v)    { attackV = v; update(); }
    event release (float v)   { releaseV = v; update(); }
    event cutoff (float v)    { cutoffV = v; update(); }
    event harmonics (float v) { harmonicsV = v; update(); }
    event mix (float v)       { mixV = v; update(); }

    void update()
    {
        let t = 1.0f / float (processor.frequency);
        dryGain = 1.0f - mixV;
        wetGain = 100.0f * (mixV / harmonicsV);                     // postgain 1/ph, times the mix
        pre = 0.01f * harmonicsV;                                   // pregain ph
        g = tan (max (0.0f, min (float (pi) / float (processor.frequency) * cutoffV, 1.5676547f)));
        gk = g + 1.4142135f;
        c1 = g * min (3.4028235e38f, 1.0f / (g * gk + 1.0f));
        c2 = 2.0f * c1;
        g2 = 2.0f * g;
        slope = 1.0f / max (0.0000001192092896f, ratioV) + -1.0f;   // 1/max(ma.EPSILON, ratio) - 1
        poleRel = exp (-(t / max (t, 0.001f * releaseV)));          // ba.tau2pole(rel)
        let att = max (t, 0.001f * attackV);                        // attack in s, at least one sample
        poleAtt = exp (-(t / att));                                 // ba.tau2pole(att)
        poleKnee = exp (-(t / (0.5f * att)));                       // ba.tau2pole(att/2)
    }

    void init() { update(); }

    void main()
    {
        loop
        {
            let x = in1;
            // fi.highpass(2, fc)
            let v = x - (gk * s1 + s2);
            let s1n = s1 + c2 * v;
            let bp = s1 + c1 * v;
            let s2n = s2 + g2 * bp;
            let hp = x - (s2 + g * bp + 1.4142135f * bp);
            s1 = s1n;
            s2 = s2n;
            // co.compressor_mono
            let a = abs (hp);
            let c = a > env ? poleAtt : poleRel;
            env = a * (1.0f - c) + env * c;
            // ba.linear2db: 20*log10(max(ma.MIN, env)), log10 written log * 1/ln(10) like the Onda port
            let gdb = slope * max (20.0f * (log (max (1.175494351e-38f, env)) * 0.4342944819f) - thresholdV, 0.0f);
            err = poleKnee * (err + min (3.4028235e38f, gdbPrev - gdb));
            gdbPrev = gdb;
            let comp = hp * pow (10.0f, 0.05f * (gdb + err));
            // pregain and harmonic creator: x for x < 0, x - x^3/3 on [0, 1], 2/3 above 1
            let p = pre * comp;
            let h = p < 0.0f ? p : (p <= 1.0f ? p - 0.33333334f * (p * p * p) : 0.33333334f * 2.0f);
            out1 <- dryGain * x + wetGain * h;
            advance();
        }
    }
}
