ins 1
params:
  g = 0.9 {0.0, 0.999}
  damp = 0.3 {0.0, 0.99}

namespace ln<M = 2>:
  struct Line:
    buf: f32[M]
    idx: i32 {M, wrap}

    def tick(self, w: f32):
      y = self.buf[self.idx]
      self.buf[self.idx] = w
      self.idx += 1
      return y

init:
  d0 = ln<1008>::Line()
  d1 = ln<1150>::Line()
  d2 = ln<1278>::Line()
  d3 = ln<1380>::Line()
  d4 = ln<1498>::Line()
  d5 = ln<1606>::Line()
  d6 = ln<1732>::Line()
  d7 = ln<1860>::Line()
  yp: f32[8]
  s: f32[8]

block:
  gn = g / sqrt(8.0)
  sample:
    for i in 0..8:
      s[i] = (1.0 - damp) * yp[i] + damp * s[i]
    v: f32[8]
    for i in 0..8:
      acc = s[0]
      for j in 1..8:
        p = i & j
        par = (p ^ (p >> 1) ^ (p >> 2)) & 1
        acc += (1.0 - 2.0 * f32(par)) * s[j]
      v[i] = acc * gn
    x = in1
    yp[0] = d0.tick(v[0] + x)
    yp[1] = d1.tick(v[1] + x)
    yp[2] = d2.tick(v[2] + x)
    yp[3] = d3.tick(v[3] + x)
    yp[4] = d4.tick(v[4] + x)
    yp[5] = d5.tick(v[5] + x)
    yp[6] = d6.tick(v[6] + x)
    yp[7] = d7.tick(v[7] + x)
    out1 = (yp[0] + yp[1] + yp[2] + yp[3] + yp[4] + yp[5] + yp[6] + yp[7]) * 0.25
