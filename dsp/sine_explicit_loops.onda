params:
  freq = 440.0 {20.0, 20000.0}

init:
  phase = 0.0

block:
  inc = freq / SR
  phases: f32[BS]
  for i in 0..BS:
    phase += inc
    phase -= floor(phase)
    phases[i] = phase

  wave: f32[BS]
  for i in 0..BS:
    wave[i] = sin(TWO_PI * phases[i]) * 0.5

  frame = 0 {BS, wrap}
  sample:
    out1 = wave[frame]
    frame += 1
