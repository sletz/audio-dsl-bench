processor TanhDrive {
    input stream in1;
    output stream out1;
    input parameter float drive = 4.0 [[ min: 1.0, max: 20.0 ]];

    process { out1 = tanh (in1 * drive) * 0.5; }
}

graph Main {
    input stream in1;
    output stream out1;
    node p = TanhDrive;
    connection { in1 -> p.in1; p.out1 -> out1; }
}
