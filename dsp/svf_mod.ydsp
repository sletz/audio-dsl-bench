// TPT state variable lowpass whose cutoff is swept by a sine LFO: coefficients per sample.
processor SvfMod {
    input stream in1;
    output stream out1;
    input parameter float base = 800.0 [[ min: 50.0, max: 5000.0 ]];
    input parameter float depth = 2.0 [[ min: 0.0, max: 4.0 ]];
    input parameter float rate = 0.5 [[ min: 0.01, max: 20.0 ]];
    input parameter float q = 2.0 [[ min: 0.5, max: 20.0 ]];
    state float ph, ic1, ic2;

    process {
        let k = 1.0 / q;
        ph += rate / sampleRate;
        ph -= floor (ph);
        let lfo = sin (2.0 * pi * ph);
        let fc = base * pow (2.0, depth * lfo);
        let g = tan (pi * fc / sampleRate);
        let a1 = 1.0 / (1.0 + g * (g + k));
        let a2 = g * a1;
        let a3 = g * a2;
        let v3 = in1 - ic2;
        let v1 = a1 * ic1 + a2 * v3;
        let v2 = ic2 + a2 * ic1 + a3 * v3;
        ic1 = 2.0 * v1 - ic1;
        ic2 = 2.0 * v2 - ic2;
        out1 = v2;
    }
}

graph Main {
    input stream in1;
    output stream out1;
    node p = SvfMod;
    connection { in1 -> p.in1; p.out1 -> out1; }
}
