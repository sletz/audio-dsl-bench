        p3_2s1 = 2.0 * p3_2v1 - p3_2s1;
        p3_2s0 = 2.0 * p3_2v0 - p3_2s0;
        let p3_3u = (p3_2y - p3_3s1 - 0.38196602 * (ga3 * p3_3s1 + p3_3s0)) * ra3;
        let p3_3v1 = ga3 * p3_3u + p3_3s1;
        let p3_3v0 = ga3 * p3_3v1 + p3_3s0;
        let p3_3y = p3_3u - p3_3v1 + 0.38196602 * p3_3v0;
        p3_3s1 = 2.0 * p3_3v1 - p3_3s1;
        p3_3s0 = 2.0 * p3_3v0 - p3_3s0;
        let p3_4u = (p3_3y - p3_4s1 - 0.38196602 * (ga4 * p3_4s1 + p3_4s0)) * ra4;
        let p3_4v1 = ga4 * p3_4u + p3_4s1;
        let p3_4v0 = ga4 * p3_4v1 + p3_4s0;
        let p3_4y = p3_4u - p3_4v1 + 0.38196602 * p3_4v0;
        p3_4s1 = 2.0 * p3_4v1 - p3_4s1;
        p3_4s0 = 2.0 * p3_4v0 - p3_4s0;
        let p3_5u = (p3_4y - p3_5s1 - 0.38196602 * (ga5 * p3_5s1 + p3_5s0)) * ra5;
        let p3_5v1 = ga5 * p3_5u + p3_5s1;
        let p3_5v0 = ga5 * p3_5v1 + p3_5s0;
        let p3_5y = p3_5u - p3_5v1 + 0.38196602 * p3_5v0;
        p3_5s1 = 2.0 * p3_5v1 - p3_5s1;
        p3_5s0 = 2.0 * p3_5v0 - p3_5s0;
        // band 4: delay-equalizing allpasses at fc(1) ... fc(4) (highpass_plus_lowpass, order 5)
        let p4_1u = (hp5by - p4_1s1 - 0.38196602 * (ga1 * p4_1s1 + p4_1s0)) * ra1;
        let p4_1v1 = ga1 * p4_1u + p4_1s1;
        let p4_1v0 = ga1 * p4_1v1 + p4_1s0;
        let p4_1y = p4_1u - p4_1v1 + 0.38196602 * p4_1v0;
        p4_1s1 = 2.0 * p4_1v1 - p4_1s1;
        p4_1s0 = 2.0 * p4_1v0 - p4_1s0;
        let p4_2u = (p4_1y - p4_2s1 - 0.38196602 * (ga2 * p4_2s1 + p4_2s0)) * ra2;
        let p4_2v1 = ga2 * p4_2u + p4_2s1;
        let p4_2v0 = ga2 * p4_2v1 + p4_2s0;
        let p4_2y = p4_2u - p4_2v1 + 0.38196602 * p4_2v0;
        p4_2s1 = 2.0 * p4_2v1 - p4_2s1;
        p4_2s0 = 2.0 * p4_2v0 - p4_2s0;
        let p4_3u = (p4_2y - p4_3s1 - 0.38196602 * (ga3 * p4_3s1 + p4_3s0)) * ra3;
        let p4_3v1 = ga3 * p4_3u + p4_3s1;
        let p4_3v0 = ga3 * p4_3v1 + p4_3s0;
        let p4_3y = p4_3u - p4_3v1 + 0.38196602 * p4_3v0;
        p4_3s1 = 2.0 * p4_3v1 - p4_3s1;
        p4_3s0 = 2.0 * p4_3v0 - p4_3s0;
        let p4_4u = (p4_3y - p4_4s1 - 0.38196602 * (ga4 * p4_4s1 + p4_4s0)) * ra4;
        let p4_4v1 = ga4 * p4_4u + p4_4s1;
        let p4_4v0 = ga4 * p4_4v1 + p4_4s0;
        let p4_4y = p4_4u - p4_4v1 + 0.38196602 * p4_4v0;
        p4_4s1 = 2.0 * p4_4v1 - p4_4s1;
        p4_4s0 = 2.0 * p4_4v0 - p4_4s0;
        // band 5: delay-equalizing allpasses at fc(1) ... fc(3) (highpass_plus_lowpass, order 5)
        let p5_1u = (hp4by - p5_1s1 - 0.38196602 * (ga1 * p5_1s1 + p5_1s0)) * ra1;
        let p5_1v1 = ga1 * p5_1u + p5_1s1;
        let p5_1v0 = ga1 * p5_1v1 + p5_1s0;
        let p5_1y = p5_1u - p5_1v1 + 0.38196602 * p5_1v0;
        p5_1s1 = 2.0 * p5_1v1 - p5_1s1;
        p5_1s0 = 2.0 * p5_1v0 - p5_1s0;
        let p5_2u = (p5_1y - p5_2s1 - 0.38196602 * (ga2 * p5_2s1 + p5_2s0)) * ra2;
        let p5_2v1 = ga2 * p5_2u + p5_2s1;
        let p5_2v0 = ga2 * p5_2v1 + p5_2s0;
        let p5_2y = p5_2u - p5_2v1 + 0.38196602 * p5_2v0;
        p5_2s1 = 2.0 * p5_2v1 - p5_2s1;
        p5_2s0 = 2.0 * p5_2v0 - p5_2s0;
        let p5_3u = (p5_2y - p5_3s1 - 0.38196602 * (ga3 * p5_3s1 + p5_3s0)) * ra3;
        let p5_3v1 = ga3 * p5_3u + p5_3s1;
        let p5_3v0 = ga3 * p5_3v1 + p5_3s0;
        let p5_3y = p5_3u - p5_3v1 + 0.38196602 * p5_3v0;
        p5_3s1 = 2.0 * p5_3v1 - p5_3s1;
        p5_3s0 = 2.0 * p5_3v0 - p5_3s0;
        // band 6: delay-equalizing allpasses at fc(1) ... fc(2) (highpass_plus_lowpass, order 5)
        let p6_1u = (hp3by - p6_1s1 - 0.38196602 * (ga1 * p6_1s1 + p6_1s0)) * ra1;
        let p6_1v1 = ga1 * p6_1u + p6_1s1;
        let p6_1v0 = ga1 * p6_1v1 + p6_1s0;
        let p6_1y = p6_1u - p6_1v1 + 0.38196602 * p6_1v0;
        p6_1s1 = 2.0 * p6_1v1 - p6_1s1;
        p6_1s0 = 2.0 * p6_1v0 - p6_1s0;
        let p6_2u = (p6_1y - p6_2s1 - 0.38196602 * (ga2 * p6_2s1 + p6_2s0)) * ra2;
        let p6_2v1 = ga2 * p6_2u + p6_2s1;
        let p6_2v0 = ga2 * p6_2v1 + p6_2s0;
        let p6_2y = p6_2u - p6_2v1 + 0.38196602 * p6_2v0;
        p6_2s1 = 2.0 * p6_2v1 - p6_2s1;
        p6_2s0 = 2.0 * p6_2v0 - p6_2s0;
        // band 7: delay-equalizing allpasses at fc(1) ... fc(1) (highpass_plus_lowpass, order 5)
        let p7_1u = (hp2by - p7_1s1 - 0.38196602 * (ga1 * p7_1s1 + p7_1s0)) * ra1;
        let p7_1v1 = ga1 * p7_1u + p7_1s1;
        let p7_1v0 = ga1 * p7_1v1 + p7_1s0;
        let p7_1y = p7_1u - p7_1v1 + 0.38196602 * p7_1v0;
        p7_1s1 = 2.0 * p7_1v1 - p7_1s1;
        p7_1s0 = 2.0 * p7_1v0 - p7_1s0;
        // faders: band i through si.smoo (error form) of Band(10-i), ba.db2linear
        pv[0] = band10;
        pv[1] = band9;
        pv[2] = band8;
        pv[3] = band7;
        pv[4] = band6;
        pv[5] = band5;
        pv[6] = band4;
        pv[7] = band3;
        pv[8] = band2;
        pv[9] = band1;
        for i in 0..10 {
            fe[i] = smoo * (fe[i] + min (3.4028235e38, fxq[i] - pv[i]));
            fxq[i] = pv[i];
            fg[i] = pow (10.0, 0.05 * (pv[i] + fe[i]));
        }
        let y = p0_8y * fg[0] + p1_7y * fg[1] + p2_6y * fg[2] + p3_5y * fg[3] + p4_4y * fg[4] + p5_3y * fg[5] + p6_2y * fg[6] + p7_1y * fg[7] + hp1by * fg[8] + lp1bv2 * fg[9];
        out1 = y;
    }
}

graph Main {
    input stream in1;
    output stream out1;
    node p = FilterBank;
    connection { in1 -> p.in1; p.out1 -> out1; }
}
