// 2D ambisonic decoder, order 3 (7 channels: W, C1, S1, C2, S2, C3, S3) to 8 speakers,
// max-rE weights, matrix as literal constants as generated by a decoder toolbox.
processor HoaDecoder
{
    input stream float in1;
    input stream float in2;
    input stream float in3;
    input stream float in4;
    input stream float in5;
    input stream float in6;
    input stream float in7;
    output stream float out1;
    output stream float out2;
    output stream float out3;
    output stream float out4;
    output stream float out5;
    output stream float out6;
    output stream float out7;
    output stream float out8;

    let M = float[8, 7] (
        (0.125f, 0.230969883f, 0.0f, 0.176776695f, 0.0f, 0.095670858f, 0.0f),
        (0.125f, 0.163320371f, 0.163320371f, 0.0f, 0.176776695f, -0.067649513f, 0.067649513f),
        (0.125f, 0.0f, 0.230969883f, -0.176776695f, 0.0f, 0.0f, -0.095670858f),
        (0.125f, -0.163320371f, 0.163320371f, 0.0f, -0.176776695f, 0.067649513f, 0.067649513f),
        (0.125f, -0.230969883f, 0.0f, 0.176776695f, 0.0f, -0.095670858f, 0.0f),
        (0.125f, -0.163320371f, -0.163320371f, 0.0f, 0.176776695f, 0.067649513f, -0.067649513f),
        (0.125f, 0.0f, -0.230969883f, -0.176776695f, 0.0f, 0.0f, 0.095670858f),
        (0.125f, 0.163320371f, -0.163320371f, 0.0f, -0.176776695f, -0.067649513f, -0.067649513f));

    void main()
    {
        loop
        {
            let x = float[7] (in1, in2, in3, in4, in5, in6, in7);
            float[8] y;
            for (wrap<8> k)
            {
                var acc = 0.0f;
                for (wrap<7> j)
                    acc += M[k, j] * x[j];
                y[k] = acc;
            }
            out1 <- y[0];
            out2 <- y[1];
            out3 <- y[2];
            out4 <- y[3];
            out5 <- y[4];
            out6 <- y[5];
            out7 <- y[6];
            out8 <- y[7];
            advance();
        }
    }
}
