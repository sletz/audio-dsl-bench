# 16-channel mixer: dB gain and constant-power pan per channel, master gain,
# Compute control-rate coefficients once per block and group the audio inputs by name.

ins:
  channels: f32[16]

const def default_pan() -> f32[16]:
  values: f32[16]
  for channel in 0..16:
    values[channel] = f32(channel) / 15.0
  return values

params:
  gain: f32[16] = -6.0 {-60.0, 12.0}
  pan: f32[16] = default_pan() {0.0, 1.0}
  master = -3.0 {-60.0, 12.0}

block:
  db = log(10.0) * 0.05
  m = exp(db * master)
  gl: f32[16]
  gr: f32[16]
  for i in 0..16:
    g = exp(db * gain[i]) * m
    gl[i] = g * cos(pan[i] * PI * 0.5)
    gr[i] = g * sin(pan[i] * PI * 0.5)
  sample:
    l = 0.0
    r = 0.0
    l2 = 0.0
    r2 = 0.0
    for i in 0..8:
      l += channels[i] * gl[i]
      r += channels[i] * gr[i]
      l2 += channels[i + 8] * gl[i + 8]
      r2 += channels[i + 8] * gr[i + 8]
    out1 = l + l2
    out2 = r + r2
